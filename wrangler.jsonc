{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launchloom-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // No production cron. Local-only proof recipe, never deploy this environment.
  "env": {
    "operations-dispatch-local": {
      "name": "launchloom-operations-dispatch-local",
      "routes": [],
      "workers_dev": false,
      "triggers": { "crons": ["* * * * *"] },
      "vars": { "OPERATIONS_DISPATCH_MODE": "disabled", "OPERATIONS_CLAIM_GATE": "disabled" },
    },
  },
  "access": {
    "dev": {
      "aud": "launchloom-local-onboarding-admin",
      "identity": { "email": "admin@example.test" },
    },
  },
  "routes": [
    { "pattern": "api.launchloom.wrazyos.com", "custom_domain": true },
  ],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "launchloom-assets" }],
  "assets": {
    "directory": "./worker/admin-dist",
    "binding": "ADMIN_STATIC",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REVISION_COORDINATOR",
        "class_name": "RevisionCoordinator",
      },
      {
        "name": "ONBOARDING_INVITES",
        "class_name": "OnboardingInvites",
      },
      {
        "name": "GENERATION_LEDGER",
        "class_name": "GenerationLedger",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-revision-coordinator",
      "new_sqlite_classes": ["RevisionCoordinator"],
    },
    {
      "tag": "v2-onboarding-invites",
      "new_sqlite_classes": ["OnboardingInvites"],
    },
    {
      "tag": "v3-generation-ledger",
      "new_sqlite_classes": ["GenerationLedger"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ASSET_BASE_URL": "https://assets.launchloom.wrazyos.com",
    "PLATFORM_ORIGINS": "https://api.launchloom.wrazyos.com,https://launchloom-bhl.pages.dev,https://launchloom.wrazyos.com",
    "PREVIEW_ORIGIN": "https://launchloom-api.dark-sound-e4eb.workers.dev",
  },
}
