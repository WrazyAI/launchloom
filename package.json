{
  "name": "launchloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:onboarding-pages": "node scripts/prepare-onboarding-pages.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:worker": "tsc -p worker/tsconfig.json && tsc -p worker/test/tsconfig.json",
    "test": "vitest run --dir tests",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "evaluate:models": "node scripts/evaluate-models.mjs",
    "evaluate:visual-models": "node scripts/evaluate-visual-models.mjs",
    "quality:visual": "node scripts/visual-quality-gate.mjs",
    "build:design-demos": "node scripts/build-design-demos.mjs",
    "build:a1-showcase": "node scripts/build-a1-design-showcase.mjs",
    "build:design-families": "node scripts/build-design-family-demos.mjs",
    "build:experience-packs": "node scripts/build-experience-pack-demos.mjs",
    "compile:inspiration": "node scripts/compile-inspiration-pack.mjs",
    "analyze:references": "node scripts/analyze-reference-dna.mjs",
    "author:experiences": "node scripts/author-production-experiences.mjs",
    "bakeoff:experience": "node scripts/run-experience-bakeoff.mjs",
    "bakeoff:creative": "node scripts/run-creative-bakeoff.mjs",
    "repair:creative": "node scripts/run-rendered-creative-repair.mjs",
    "canary:creative": "node scripts/run-creative-canary.mjs",
    "canary:creative:renderer": "node scripts/run-creative-renderer-canary.mjs",
    "promote:creative": "node scripts/promote-creative-candidate.mjs",
    "generate:model-experiences": "node scripts/generate-model-experience-lab.mjs",
    "build:template-gallery": "node scripts/build-template-variant-gallery.mjs",
    "verify:onboarding-ui": "ONBOARDING_VERIFY_PORT=4179 PUBLIC_LAUNCHLOOM_API_URL=http://127.0.0.1:4179 npm run build && ONBOARDING_VERIFY_PORT=4179 node scripts/verify-onboarding-ui.mjs",
    "verify:client-pipeline-fixtures": "node scripts/verify-client-pipeline-fixtures.mjs",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "preflight:reasoning": "node scripts/run-reasoning-preflight.mjs",
    "capture:gold-reference": "node scripts/capture-gold-reference-evidence.mjs",
    "audit:gold-references": "node scripts/audit-gold-reference-library.mjs",
    "benchmark:gold-references": "node scripts/run-gold-reference-benchmark.mjs"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "@fal-ai/client": "1.10.1",
    "astro": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "0.35.4",
    "zod": "latest"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/vitest-plugin": "^1.1.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@msw/cloudflare": "^0.0.1",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "msw": "^2.15.0",
    "playwright": "^1.63.0",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "^4.130.0"
  }
}
