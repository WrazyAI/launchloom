---
const { compact = false, hideNav = false } = Astro.props;
---

<header class:list={["site-header", { compact }]}>
  <a class="brand" href="/" aria-label="LaunchLoom home">
    <span class="brand-mark" aria-hidden="true">L</span>
    <span>launchloom</span>
  </a>
  {!hideNav && (
    <nav aria-label="Primary navigation">
      <a href="/#how-it-works">How it works</a>
    </nav>
  )}
</header>
