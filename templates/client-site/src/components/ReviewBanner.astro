---
const launchloomUrl = (import.meta.env.PUBLIC_LAUNCHLOOM_URL || "").replace(/\/$/, "");
---

<aside class="ll-review" id="ll-review" hidden aria-label="LaunchLoom website review">
  <div class="ll-review__bar">
    <p><span aria-hidden="true">▣</span> This is a draft of your new website — does it look right?</p>
    <div class="ll-review__actions">
      <button class="ll-approve" type="button">✓ Approve</button>
      <button class="ll-feedback-open" type="button">⌁ Provide feedback</button>
    </div>
  </div>
  <div class="ll-review__modal" hidden role="dialog" aria-modal="true" aria-labelledby="ll-review-title">
    <div class="ll-review__dialog">
      <button class="ll-close" type="button" aria-label="Close feedback form">×</button>
      <h2 id="ll-review-title">What would you like changed?</h2>
      <p>Tap what applies, then leave a clear note. We’ll group your requests into one focused revision.</p>
      <div class="ll-categories" aria-label="Feedback category">
        <button type="button" data-category="Logo">Logo</button><button type="button" data-category="Phone number">Phone number</button><button type="button" data-category="Hero image">Hero image</button><button type="button" data-category="Wording">Wording</button><button type="button" data-category="Colors">Colors</button><button type="button" data-category="Services">Services</button><button type="button" data-category="Photos">Photos</button>
      </div>
      <form class="ll-feedback-form">
        <label>Your review email<input type="email" name="email" required autocomplete="email" placeholder="The email we sent this preview to" /></label>
        <label>What should change?<textarea name="comment" required maxlength="5000" placeholder="For example: Make the main headline more direct and use a warmer hero photo."></textarea></label>
        <p class="ll-feedback-status" role="status"></p>
        <div class="ll-modal-actions"><button class="ll-cancel" type="button">Back</button><button class="ll-send" type="submit">Send feedback</button></div>
      </form>
    </div>
  </div>
</aside>

<script is:inline define:vars={{ launchloomUrl }}>
  const root = document.querySelector("#ll-review");
  const token = new URLSearchParams(window.location.search).get("review");
  if (!root || !token || !launchloomUrl) {
    root?.setAttribute("hidden", "");
  } else {
    root.removeAttribute("hidden");
    const modal = root.querySelector(".ll-review__modal");
    const open = root.querySelector(".ll-feedback-open");
    const close = root.querySelector(".ll-close");
    const cancel = root.querySelector(".ll-cancel");
    const approve = root.querySelector(".ll-approve");
    const form = root.querySelector(".ll-feedback-form");
    const status = root.querySelector(".ll-feedback-status");
    let category = "";
    const setModal = (visible) => modal.toggleAttribute("hidden", !visible);
    open.addEventListener("click", () => setModal(true));
    close.addEventListener("click", () => setModal(false));
    cancel.addEventListener("click", () => setModal(false));
    root.querySelectorAll("[data-category]").forEach((button) => button.addEventListener("click", () => {
      category = button.dataset.category || "";
      root.querySelectorAll("[data-category]").forEach((item) => item.classList.toggle("is-active", item === button));
    }));
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      status.textContent = "Sending…";
      try {
        const response = await fetch(`${launchloomUrl}/api/feedback`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, email: data.get("email"), comment: data.get("comment"), category, pageUrl: window.location.href }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Feedback could not be sent.");
        status.textContent = "Received — we’ll turn this into the next revision.";
        form.reset();
      } catch (error) { status.textContent = error instanceof Error ? error.message : "Feedback could not be sent."; }
    });
    approve.addEventListener("click", async () => {
      if (!window.confirm("Approve this exact version for publishing? A newer revision will need a new approval.")) return;
      approve.disabled = true;
      approve.textContent = "Approving…";
      try {
        const response = await fetch(`${launchloomUrl}/api/approval`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Approval could not be recorded.");
        approve.textContent = "Approved ✓";
      } catch (error) { approve.disabled = false; approve.textContent = error instanceof Error ? error.message : "Approve"; }
    });
  }
</script>
