      clientPreviewName.className = "ll-attachment__name";
      const removePreview = document.createElement("button");
      removePreview.type = "button";
      removePreview.className = "ll-attachment__remove";
      removePreview.textContent = "Remove";
      previewMeta.append(clientPreviewBadge, clientPreviewName, removePreview);
      clientPreview.append(previewThumb, previewMeta);
      clientStatus = document.createElement("p");
      clientStatus.className = "ll-part-status";
      clientStatus.setAttribute("role", "status");
      clientImageHost.append(
        imageHead,
        targetLabel,
        choices,
        clientBusyCard,
        clientPreview,
        clientStatus,
      );

      clientColorHost = document.createElement("div");
      clientColorHost.className = "ll-colors";
      clientColorSection = document.createElement("section");
      clientColorSection.className = "ll-part";
      clientColorSection.hidden = true;
      const colorHeading = document.createElement("h3");
      colorHeading.textContent = "Colors";
      const colorHint = document.createElement("p");
      colorHint.className = "ll-part-status";
      colorHint.textContent = "Pick the colors you like. We will adjust the rest so text stays easy to read.";
      clientColorSection.append(colorHeading, colorHint, clientColorHost);

      clientFields.hidden = false;
      clientFields.append(categoryLabel, clientImageHost, clientColorSection);
      clientCategorySelect.addEventListener("change", () => {
        clientCategory = clientCategorySelect.value;
        clientFile = null;
        clientGenerated = null;
        clientPrompt.value = "";
        if (clientFileInput) clientFileInput.value = "";
        setClientStatus("");
        commentInput.placeholder =
          clientCategory === "text"
            ? 'Quote the exact text and replacement, for example: Replace text "Same day service" with "Prompt scheduling".'
            : "Tell us what you would like changed. Bigger redesigns are handled separately.";
        renderClientTargets();
        renderClientPreview();
        setClientImageVisibility();
        updateDraftHint();
      });
      clientTargetSelect.addEventListener("change", () => {
        clientTarget = clientTargetSelect.value;
        clientGenerated = null;
        setClientStatus("");
        renderClientPreview();
        updateDraftHint();
      });
      clientFileInput.addEventListener("change", () => {
        clientFile = clientFileInput.files?.[0] || null;
        if (clientFile) clientGenerated = null;
        setClientStatus("");
        renderClientPreview();
        updateDraftHint();
      });
      clientGenerateButton.addEventListener("click", async () => {
        const submittedEmail = String(emailInput.value || "").trim().toLowerCase();
        if (!submittedEmail) {
          emailInput.setCustomValidity("Enter the review email before generating an image.");
          emailInput.reportValidity();
          setClientStatus("Enter the review email before generating an image.", true);
          return;
        }
        emailInput.setCustomValidity("");
        const prompt = String(clientPrompt.value || "").trim();
        if (prompt.length < 3) {
          setClientStatus("Describe the image first.", true);
          return;
        }
        clientGenerateButton.disabled = true;
        clientGenerating = true;
        setClientStatus("Creating an image…");
        try {
          const response = await fetch(`${launchloomUrl}/api/feedback-image`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, email: submittedEmail, pageUrl: window.location.href, target: clientTarget, prompt }),
          });
          const result = await response.json().catch(() => ({}));
          const url = result.images?.[0]?.url;
          if (!response.ok || !url) throw new Error(result.error || "We could not create the image.");
          clientGenerated = { url, prompt, model: result.model || "" };
          clientFile = null;
          if (clientFileInput) clientFileInput.value = "";
          setClientStatus("Created. Use this image, or create another.");
        } catch (error) {
          setClientStatus(error instanceof Error ? error.message : "We could not create the image.", true);
        } finally {
          clientGenerating = false;
          clientGenerateButton.disabled = false;
          renderClientPreview();
          updateDraftHint();
        }
      });
      removePreview.addEventListener("click", () => {
        clientGenerated = null;
        clientFile = null;
        if (clientFileInput) clientFileInput.value = "";
        setClientStatus("");
        renderClientPreview();
        updateDraftHint();
      });
      renderClientTargets();
      renderClientColors();
      setClientImageVisibility();
    }

    async function submitClientFeedback(submittedEmail) {
      const imageCategory = clientCategory === "logo" || clientCategory === "photos";
      if (imageCategory && !clientFile && !clientGenerated) {
        setStatusText("Add a photo or create one.");
        return false;
      }
      if (["text", "contact", "style", "other-small"].includes(clientCategory) && !commentInput.value.trim()) {
        setStatusText("Tell us what you would like changed.");
        return false;
      }
      const colorSelections = clientColors
        .filter((role) => role.enabled)
        .map((role) => ({ role: role.id, hex: role.hex.toLowerCase() }));
      if (clientCategory === "color" && !colorSelections.length && !/#[0-9a-f]{6}/i.test(commentInput.value)) {
        setStatusText("Pick a color, or type a color code like #205d51 in the note.");
        return false;
      }
      const attachments = clientGenerated
        ? [{ target: clientTarget, kind: "generated", url: clientGenerated.url, prompt: clientGenerated.prompt, model: clientGenerated.model }]
        : [];
      const details = { attachments, colors: colorSelections };
      try {
        let response;
        if (clientFile) {
          const body = new FormData();
          body.set("token", token);
          body.set("comment", commentInput.value.trim() || "Please replace this image with the one I uploaded.");
          body.set("category", clientCategory);
          body.set("email", submittedEmail);
          body.set("pageUrl", window.location.href);
          body.set("submissionId", feedbackSubmissionId);
          body.set("replacementTarget", clientTarget);
          body.set("replacementAsset", clientFile);
          if (colorSelections.length) body.set("details", JSON.stringify(details));
          response = await fetch(`${launchloomUrl}/api/feedback`, { method: "POST", body });
        } else {
          response = await fetch(`${launchloomUrl}/api/feedback`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              token,
              comment: commentInput.value,
              category: clientCategory,
              email: submittedEmail,
              pageUrl: window.location.href,
              submissionId: feedbackSubmissionId,
              details,
            }),
          });
        }
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          setStatusText(result.error || "Feedback could not be sent.");
          return false;
        }
        setStatusText(
          result.queueStatus === "queued"
            ? "Queued. Your request will start after the current update."
            : "Received. We will review your request before publishing an update.",
        );
        feedbackSubmissionId = "";
        clientCategorySelect.value = "text";
        clientCategory = "text";
        clientFile = null;
        clientGenerated = null;
        clientPrompt.value = "";
        if (clientFileInput) clientFileInput.value = "";
        for (const role of clientColors) role.enabled = false;
        renderClientTargets();
        renderClientColors();
        renderClientPreview();
        setClientImageVisibility();
        return true;
      } catch {
        setStatusText("Feedback could not be sent.");
        return false;
      }
    }

    // ------------------------------------------------------------- developer
    const IMAGE_PARTS = [
      { id: "logo", label: "Logo", prompt: "Describe the logo you want" },
      { id: "hero", label: "Main image at the top", prompt: "Describe the image you want at the top of the page" },
      { id: "secondary", label: "About image", prompt: "Describe the image you want in the about section" },
      { id: "tertiary", label: "Gallery photos", prompt: "Describe a gallery photo you want" },
      { id: "team", label: "Team photo", prompt: "Describe the team photo you want" },
    ];
    const TEXT_PARTS = [
      { id: "navigation", label: "Menu", hint: "For example: keep the menu short and put Contact last." },
      { id: "wording", label: "Wording", hint: "For example: make the headline more direct." },
      { id: "services", label: "Services", hint: "For example: rename a service or clarify what it covers." },
      { id: "phone", label: "Phone number", hint: "For example: make the phone number easier to find." },
      { id: "faq", label: "Common questions", hint: "For example: add a question about coverage." },
    ];
    const COLOR_ROLES = [
      { id: "primary", label: "Main brand color", fallback: "#1f3a5f" },
      { id: "surface", label: "Page background", fallback: "#faf7f2" },
      { id: "hero", label: "Top section background", fallback: "#e8f0f1", advanced: true },
      { id: "ink", label: "Main text", fallback: "#17242b", advanced: true },
      { id: "muted", label: "Smaller, lighter text", fallback: "#5b6b72", advanced: true },
      { id: "line", label: "Lines and borders", fallback: "#d7e0e2", advanced: true },
    ];
    const selectedParts = new Set();
    const notes = {};
    const drafts = {};
    const colorChoices = {};
    let showBrandName = false;
    let showAdvancedColors = false;
    let renderColorRoles = () => {};

    for (const role of COLOR_ROLES)
      colorChoices[role.id] = {
        enabled: false,
        hex: /^#[0-9a-f]{6}$/i.test(palette[role.id] || "")
          ? palette[role.id]
          : role.fallback,
      };
    for (const id of [...IMAGE_PARTS.map((part) => part.id), ...TEXT_PARTS.map((part) => part.id)])
      drafts[id] = { status: "", busy: false };

    const statusFor = (id) => root.querySelector(`[data-part-status="${id}"]`);
    const sectionFor = (id) => root.querySelector(`[data-part-section="${id}"]`);
    const setStatus = (id, text, error = false) => {
      const target = statusFor(id);
      if (!target) return;
      target.textContent = text;
      target.classList.toggle("is-error", Boolean(error));
      target.classList.toggle("is-success", Boolean(text) && !error);
    };
    const renderPreview = (id) => {
      const draft = drafts[id];
      const preview = root.querySelector(`[data-part-preview="${id}"]`);
      const busy = root.querySelector(`[data-part-busy="${id}"]`);
      const chosen = draft.generated || draft.upload;
      if (busy) busy.hidden = !(draft.busy && !chosen);
      if (!preview) return;
      preview.toggleAttribute("hidden", !chosen);
      if (!chosen) return;
      const image = preview.querySelector("img");
      const fallback = preview.querySelector(".ll-attachment__fallback");
      if (image && fallback && image.getAttribute("src") !== chosen.url) {
        image.hidden = false;
        fallback.hidden = true;
        image.onerror = () => {
          image.hidden = true;
          fallback.hidden = false;
        };
        image.src = chosen.url;
      }
      const badge = preview.querySelector("[data-part-preview-badge]");
      if (badge)
        badge.textContent = draft.generated ? "Created for you" : "Your image";
      const name = preview.querySelector("[data-part-preview-name]");
      if (name)
        name.textContent = draft.generated
          ? draft.generated.prompt || ""
          : draft.upload?.name || "";
    };

    function buildDeveloperForm() {
      partsHost.hidden = false;
      sectionsHost.hidden = false;
      const chip = (id, label) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "ll-part-chip";
        button.dataset.part = id;
        button.setAttribute("aria-pressed", "false");
        const mark = document.createElement("span");
        mark.className = "ll-part-chip__mark";
        mark.setAttribute("aria-hidden", "true");
        button.append(mark, label);
        button.addEventListener("click", () => {
          if (selectedParts.has(id)) {
            selectedParts.delete(id);
            button.setAttribute("aria-pressed", "false");
            button.classList.remove("is-active");
          } else {
            selectedParts.add(id);
            button.setAttribute("aria-pressed", "true");
            button.classList.add("is-active");
          }
          const section = sectionFor(id);
          if (section) section.hidden = !selectedParts.has(id);
          updateDraftHint();
        });
        return button;
      };
      for (const part of IMAGE_PARTS) partsHost.append(chip(part.id, part.label));
      for (const part of TEXT_PARTS) partsHost.append(chip(part.id, part.label));
      partsHost.append(chip("colors", "Colors"));

      const noteField = (id, label, placeholder) => {
        const wrapper = document.createElement("label");
        wrapper.textContent = label;
        const textarea = document.createElement("textarea");
        textarea.dataset.partNote = id;
        textarea.maxLength = 2000;
        textarea.placeholder = placeholder;
        textarea.addEventListener("input", () => {
          notes[id] = textarea.value;
          updateDraftHint();
        });
        wrapper.append(textarea);
        return wrapper;
      };

      const uploadImage = async (id, file) => {
        const reviewerEmail = String(emailInput.value || "").trim().toLowerCase();
        if (!reviewerEmail) {
          emailInput.setCustomValidity("Enter the review email before adding an image.");
          emailInput.reportValidity();
          status.textContent = "Enter the review email before adding an image.";
          return;
        }
        emailInput.setCustomValidity("");
        drafts[id].busy = true;
        drafts[id].status = "Uploading the image…";
        setStatus(id, drafts[id].status);
        try {
          const prepared = await compressFeedbackImage(file);
          const body = new FormData();
          body.set("token", token);
          body.set("email", reviewerEmail);
          body.set("pageUrl", window.location.href);
          body.set("target", id);
          body.set("file", prepared);
          const response = await fetch(`${launchloomUrl}/api/feedback-image`, { method: "POST", body });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.url) throw new Error(result.error || "We could not upload the image.");
          drafts[id].upload = { url: result.url, name: file.name };
          drafts[id].generated = undefined;
          drafts[id].status = "Uploaded. It will replace this image in the next update.";
          drafts[id].error = false;
        } catch (error) {
          drafts[id].status = error instanceof Error ? error.message : "We could not upload the image.";
          drafts[id].error = true;
        } finally {
          drafts[id].busy = false;
          setStatus(id, drafts[id].status, drafts[id].error);
          renderPreview(id);
          updateDraftHint();
        }
      };

      const generateImage = async (id) => {
        const reviewerEmail = String(emailInput.value || "").trim().toLowerCase();
        if (!reviewerEmail) {
          emailInput.setCustomValidity("Enter the review email before generating an image.");
          emailInput.reportValidity();
          status.textContent = "Enter the review email before generating an image.";
          return;
        }
        emailInput.setCustomValidity("");
        const promptInput = root.querySelector(`[data-part-prompt="${id}"]`);
        const prompt = String(promptInput?.value || "").trim();
        if (prompt.length < 3) {
          drafts[id].status = "Describe the image first.";
          drafts[id].error = true;
          setStatus(id, drafts[id].status, true);
          return;
        }
        drafts[id].busy = true;
        drafts[id].status = "Creating an image…";
        setStatus(id, drafts[id].status, false);
        renderPreview(id);
        try {
          const response = await fetch(`${launchloomUrl}/api/feedback-image`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, email: reviewerEmail, pageUrl: window.location.href, target: id, prompt }),
          });
          const result = await response.json().catch(() => ({}));
          const url = result.images?.[0]?.url;
          if (!response.ok || !url) throw new Error(result.error || "We could not create the image.");
          drafts[id].generated = { url, prompt, model: result.model || "" };
          drafts[id].upload = undefined;
          drafts[id].status = "Created. Use this image, or create another.";
          drafts[id].error = false;
        } catch (error) {
          drafts[id].status = error instanceof Error ? error.message : "We could not create the image.";
          drafts[id].error = true;
        } finally {
          drafts[id].busy = false;
          setStatus(id, drafts[id].status, drafts[id].error);
          renderPreview(id);
          updateDraftHint();
        }
      };

      const imageSection = (part) => {
        const section = document.createElement("section");
        section.className = "ll-part";
        section.dataset.partSection = part.id;
        section.hidden = true;
        section.innerHTML = `<header class="ll-part__head"><h3>${part.label}</h3><button type="button" class="ll-part__off" data-part-off="${part.id}">Turn off</button></header>
<div class="ll-part__choices">
  <div class="ll-choice">
    <span class="ll-choice__title">Use your own image</span>
    <span class="ll-choice__hint">PNG, JPG, or WebP up to 3 MB</span>
    <label class="ll-choice__file"><input type="file" accept="image/png,image/jpeg,image/webp" data-part-file="${part.id}"><span>Choose a file</span></label>
  </div>
  <div class="ll-choice ll-choice--generate">
    <span class="ll-choice__title">Or create one for me</span>
    <label><span class="visually-hidden">${part.prompt}</span><textarea data-part-prompt="${part.id}" maxlength="500" placeholder="For example: a calm, warm photo of the work in progress, no text."></textarea></label>
    <button type="button" class="ll-generate" data-part-generate="${part.id}">Create an image</button>
  </div>
</div>
<div class="ll-attachment ll-attachment--busy" data-part-busy="${part.id}" hidden><span class="ll-attachment__thumb ll-attachment__thumb--skeleton"></span><div class="ll-attachment__meta"><span class="ll-attachment__badge">Working…</span><span class="ll-attachment__name">This can take a moment.</span></div></div>
<figure class="ll-attachment" data-part-preview="${part.id}" hidden><span class="ll-attachment__thumb"><img alt="" /><span class="ll-attachment__fallback" hidden>No preview</span></span><figcaption class="ll-attachment__meta"><span class="ll-attachment__badge" data-part-preview-badge></span><span class="ll-attachment__name" data-part-preview-name></span><button type="button" class="ll-attachment__remove" data-part-clear="${part.id}">Remove</button></figcaption></figure>
<p class="ll-part-status" data-part-status="${part.id}" role="status"></p>
<label>Note (optional)<textarea data-part-note="${part.id}" maxlength="2000" placeholder="Anything else about this image?"></textarea></label>`;
        section.querySelector(`[data-part-off="${part.id}"]`).addEventListener("click", () => {
          root.querySelector(`[data-part="${part.id}"]`)?.click();
        });
        const note = section.querySelector(`[data-part-note="${part.id}"]`);
        note.addEventListener("input", () => {
          notes[part.id] = note.value;
          updateDraftHint();
