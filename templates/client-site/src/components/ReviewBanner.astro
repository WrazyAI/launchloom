---
const launchloomUrl = (import.meta.env.PUBLIC_LAUNCHLOOM_API_URL || import.meta.env.PUBLIC_LAUNCHLOOM_URL || "").replace(/\/$/, "");
---

<aside class="ll-review" id="ll-review" hidden aria-label="LaunchLoom website review">
  <div class="ll-review__bar">
    <p class="ll-review__summary"><span aria-hidden="true">▣</span> Review this website</p>
    <div class="ll-review__actions">
      <button class="ll-approve" type="button" hidden>✓ Approve &amp; send to client</button>
      <button class="ll-feedback-open" type="button">⌁ Provide feedback</button>
    </div>
  </div>
  <div class="ll-review__modal" hidden role="dialog" aria-modal="true" aria-labelledby="ll-review-title">
    <div class="ll-review__dialog">
      <div class="ll-close-control">
        <button class="ll-close" type="button" aria-label="Close feedback form">×</button>
        <span class="ll-close-tip" id="ll-close-draft-tip" role="tooltip" hidden>Draft stays here when closed.</span>
      </div>
      <h2 id="ll-review-title">What would you like changed?</h2>
      <p class="ll-review__intro">Tap what applies, then leave a clear note.</p>
      <div class="ll-categories" aria-label="Feedback category">
        <button type="button" data-category="Logo" aria-pressed="false">Logo</button><button type="button" data-category="Phone number" aria-pressed="false">Phone number</button><button type="button" data-category="Hero image" aria-pressed="false">Hero image</button><button type="button" data-category="Wording" aria-pressed="false">Wording</button><button type="button" data-category="Colors" aria-pressed="false">Colors</button><button type="button" data-category="Services" aria-pressed="false">Services</button><button type="button" data-category="Photos" aria-pressed="false">Photos</button>
      </div>
      <form class="ll-feedback-form">
        <label>Your review email<input type="email" name="email" required autocomplete="email" placeholder="The email we sent this link to" /></label>
        <label>What should change?<textarea name="comment" required maxlength="5000" placeholder="For example: Make the main headline more direct and use a warmer hero photo."></textarea></label>
        <p class="ll-feedback-status" role="status"></p>
        <div class="ll-modal-actions"><button class="ll-cancel" type="button">Back</button><button class="ll-send" type="submit">Send feedback</button></div>
      </form>
    </div>
  </div>
</aside>

<style>
  .ll-close-control {
    position: absolute;
    right: 14px;
    top: 10px;
    z-index: 2;
  }

  .ll-close-control .ll-close {
    position: static;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
  }

  .ll-close-tip {
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    width: max-content;
    max-width: min(230px, calc(100vw - 56px));
    padding: 8px 10px;
    border-radius: 5px;
    background: #18251f;
    color: #fff;
    box-shadow: 0 8px 24px #0003;
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.35;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-3px);
    transition:
      opacity 120ms ease,
      transform 120ms ease,
      visibility 120ms ease;
  }

  .ll-close-tip[hidden] {
    display: none;
  }

  .ll-close-control:hover .ll-close-tip,
  .ll-close-control:focus-within .ll-close-tip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>

<script is:inline define:vars={{ launchloomUrl }}>
  const root = document.querySelector("#ll-review");
  const token = new URLSearchParams(window.location.search).get("review");
  const claims = (() => {
    try {
      const encoded = token?.split(".")[0]?.replace(/-/g, "+").replace(/_/g, "/") || "";
      return JSON.parse(atob(encoded.padEnd(encoded.length + ((4 - encoded.length % 4) % 4), "=")));
    } catch { return null; }
  })();
  if (!root || !token || !launchloomUrl || !["developer", "client"].includes(claims?.stage)) {
    root?.setAttribute("hidden", "");
  } else {
    root.removeAttribute("hidden");
    const developer = claims.stage === "developer";
    const modal = root.querySelector(".ll-review__modal");
    const open = root.querySelector(".ll-feedback-open");
    const close = root.querySelector(".ll-close");
    const closeTip = root.querySelector(".ll-close-tip");
    const cancel = root.querySelector(".ll-cancel");
    const approve = root.querySelector(".ll-approve");
    const form = root.querySelector(".ll-feedback-form");
    const status = root.querySelector(".ll-feedback-status");
    const emailInput = form.querySelector('input[name="email"]');
    const commentInput = form.querySelector('textarea[name="comment"]');
    const send = form.querySelector(".ll-send");
    const selectedCategories = new Set();
    let feedbackSubmissionId = "";
    const updateDraftHint = () => {
      const hasDraft = Boolean(
        selectedCategories.size ||
        commentInput.value.trim()
      );
      closeTip.toggleAttribute("hidden", !hasDraft);
      if (hasDraft) close.setAttribute("aria-describedby", "ll-close-draft-tip");
      else close.removeAttribute("aria-describedby");
    };
    root.querySelector(".ll-review__summary").innerHTML = developer
      ? "<span aria-hidden=\"true\">▣</span> Internal developer review. Approve before the client sees this."
      : "<span aria-hidden=\"true\">▣</span> Your website is live. Tell us what you would like changed.";
    root.querySelector(".ll-review__intro").textContent = developer
      ? "Leave clear internal notes, or approve this exact version to publish and invite the client."
      : "Tap what applies, then leave a clear note. We will review it before publishing an update.";
    approve.toggleAttribute("hidden", !developer);
    const setModal = (visible) => {
      modal.toggleAttribute("hidden", !visible);
      if (visible) window.dispatchEvent(new CustomEvent("launchloom:overlay-open", { detail: { id: "review" } }));
    };
    open.addEventListener("click", () => setModal(true));
    close.addEventListener("click", () => setModal(false));
    cancel.addEventListener("click", () => setModal(false));
    window.addEventListener("launchloom:overlay-open", (event) => {
      if (event.detail?.id !== "review") setModal(false);
    });
    root.querySelectorAll("[data-category]").forEach((button) => button.addEventListener("click", () => {
      const value = button.dataset.category || "";
      if (selectedCategories.has(value)) selectedCategories.delete(value); else selectedCategories.add(value);
      button.classList.toggle("is-active", selectedCategories.has(value));
      button.setAttribute("aria-pressed", String(selectedCategories.has(value)));
      updateDraftHint();
    }));
    emailInput.addEventListener("input", () => { emailInput.setCustomValidity(""); updateDraftHint(); });
    commentInput.addEventListener("input", updateDraftHint);
    const verifyEmail = (submittedEmail) => {
      if (submittedEmail === String(claims.reviewerEmail || "").toLowerCase()) return true;
      const message = "Use the same email address that received this review link.";
      emailInput.setCustomValidity(message); emailInput.reportValidity(); status.textContent = message; return false;
    };
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form); const submittedEmail = String(data.get("email") || "").trim().toLowerCase();
      if (!verifyEmail(submittedEmail)) return;
      feedbackSubmissionId ||= crypto.randomUUID();
      send.disabled = true;
      status.textContent = "Sending…";
      try {
        const response = await fetch(`${launchloomUrl}/api/feedback`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, email: submittedEmail, comment: data.get("comment"), category: [...selectedCategories].join(", "), pageUrl: window.location.href, submissionId: feedbackSubmissionId }) });
        const result = await response.json(); if (!response.ok) throw new Error(result.error || "Feedback could not be sent.");
        status.textContent = result.queueStatus === "queued"
          ? "Queued. Your request will start after the current revision."
          : developer ? "Received. A revised developer preview will be sent shortly." : "Received. We will review your request before publishing an update.";
        feedbackSubmissionId = "";
        form.reset(); selectedCategories.clear(); root.querySelectorAll("[data-category]").forEach((button) => { button.classList.remove("is-active"); button.setAttribute("aria-pressed", "false"); }); updateDraftHint();
      } catch (error) { status.textContent = error instanceof Error ? error.message : "Feedback could not be sent."; }
      finally { send.disabled = false; }
    });
    approve.addEventListener("click", async () => {
      if (!window.confirm("Approve this exact version, publish it, and send the client their review link?")) return;
      approve.disabled = true; approve.textContent = "Publishing…";
      try {
        // The developer identity is already bound to this signed link. Unlike
        // feedback, approval should not force the developer through the form.
        const response = await fetch(`${launchloomUrl}/api/approval`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, email: String(claims.reviewerEmail || ""), pageUrl: window.location.href }) });
        const result = await response.json(); if (!response.ok) throw new Error(result.error || "Approval could not be recorded.");
        approve.textContent = "Approved ✓";
      } catch (error) { approve.disabled = false; approve.textContent = error instanceof Error ? error.message : "Approve & send to client"; }
    });
  }
</script>
