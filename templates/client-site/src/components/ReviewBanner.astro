      const busyThumb = document.createElement("span");
      busyThumb.className = "ll-attachment__thumb ll-attachment__thumb--skeleton";
      const busyMeta = document.createElement("div");
      busyMeta.className = "ll-attachment__meta";
      const busyBadge = document.createElement("span");
      busyBadge.className = "ll-attachment__badge";
      busyBadge.textContent = "Working…";
      const busyName = document.createElement("span");
      busyName.className = "ll-attachment__name";
      busyName.textContent = "This can take a moment.";
      busyMeta.append(busyBadge, busyName);
      clientBusyCard.append(busyThumb, busyMeta);
      clientPreview = document.createElement("figure");
      clientPreview.className = "ll-attachment";
      clientPreview.hidden = true;
      const previewThumb = document.createElement("span");
      previewThumb.className = "ll-attachment__thumb";
      clientPreviewImage = document.createElement("img");
      clientPreviewImage.alt = "Selected image";
