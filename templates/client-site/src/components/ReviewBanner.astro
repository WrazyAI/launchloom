---
import site from "../lib/site";
import { seoResearchReadiness } from "../lib/seo-readiness.mjs";

const launchloomUrl = (import.meta.env.PUBLIC_LAUNCHLOOM_API_URL || import.meta.env.PUBLIC_LAUNCHLOOM_URL || "").replace(/\/$/, "");
const research = seoResearchReadiness(site);
const publishReady = research.allowed;
const factBlocked = !research.allowed && research.code === "business_facts_required";
const factReport = site.factReadiness;
const deferredFactCount = factReport?.facts.filter((fact) => fact.state === "missing-deferrable").length || 0;
const factNotice = factReport ? [
  ...(factReport.addressVisibility === "private" ? ["Business address is private and omitted from public pages and maps."] : []),
  ...factReport.facts.filter((fact) => ["contradictory", "launch-blocking"].includes(fact.state)).map((fact) => fact.reason),
  ...(deferredFactCount > 0 ? [`${deferredFactCount} optional business facts are deferred.`] : []),
].join(" ") : "";
const webResearchComplete = research.allowed && research.mode === "context-only";
const cityResearch = site.seoResearch?.coverageResearch;
const pendingCoverage = cityResearch && cityResearch.complete !== true;
const completedCityCount = cityResearch?.cities?.filter((city) => city.status === "complete").length || 0;
const confirmedCityCount = cityResearch?.areas?.length || 0;
const palette = {
  primary: site.style?.primaryColor || "",
  surface: site.style?.surfaceColor || "",
  hero: site.style?.heroColor || "",
  ink: site.style?.inkColor || "",
  muted: site.style?.mutedColor || "",
  line: site.style?.lineColor || "",
};
const { diagnosticPreview = false } = Astro.props;
---

<aside class:list={["ll-review", diagnosticPreview && "ll-review--diagnostic"]} id="ll-review" data-diagnostic-preview={diagnosticPreview ? "true" : undefined} hidden aria-label="LaunchLoom website review">
  <div class="ll-review__bar">
    <p class="ll-review__summary"><span aria-hidden="true">▣</span> Review this website</p>
    <p class="ll-review__research-notice" role="status" hidden></p>
    <p class="ll-review__fact-notice" role="status" hidden></p>
    <p class="ll-review__field-notice" role="status" hidden></p>
    <div class="ll-review__actions">
      <button class="ll-approve" type="button" hidden>✓ Approve &amp; send to client</button>
      <button class="ll-feedback-open" type="button">⌁ Provide feedback</button>
      <button class="ll-send-anyway" type="button" hidden>Send to client anyway (not recommended)</button>
    </div>
  </div>
  <dialog class="ll-override-dialog" aria-labelledby="ll-override-title">
    <div class="ll-override-dialog__content">
      <h2 id="ll-override-title">Send this field preview to the client?</h2>
      <p>This version did not pass the automated visual quality checks. You are choosing to send this exact version anyway. Build, content-integrity, readability, and SEO release checks still apply.</p>
      <p class="ll-override-status" role="status"></p>
      <div class="ll-modal-actions">
        <button class="ll-override-cancel" type="button">Keep reviewing</button>
        <button class="ll-override-confirm" type="button">Confirm and send to client</button>
      </div>
    </div>
  </dialog>
  <div class="ll-review__modal" hidden role="dialog" aria-modal="true" aria-labelledby="ll-review-title">
    <div class="ll-review__dialog">
      <div class="ll-close-control">
        <button class="ll-close" type="button" aria-label="Close feedback form">×</button>
        <span class="ll-close-tip" id="ll-close-draft-tip" role="tooltip" hidden>Draft stays here when closed.</span>
      </div>
      <h2 id="ll-review-title">What would you like changed?</h2>
      <p class="ll-review__intro">Tap what applies, then leave a clear note.</p>
      <form class="ll-feedback-form">
        <label>Your review email<input type="email" name="email" required autocomplete="email" placeholder="The email we sent this link to" /></label>
        <div class="ll-parts" aria-label="Feedback part"></div>
        <div class="ll-part-sections"></div>
        <div class="ll-client-fields" hidden></div>
        <label class="ll-general-note">Anything else?<textarea name="comment" maxlength="5000" placeholder="For example: Keep the overall direction, but make the service choices easier to scan."></textarea></label>
        <p class="ll-feedback-status" role="status"></p>
        <div class="ll-modal-actions"><button class="ll-cancel" type="button">Back</button><button class="ll-send" type="submit">Send feedback</button></div>
      </form>
    </div>
  </div>
</aside>

<style>
  .ll-close-control {
    position: absolute;
    right: 14px;
    top: 10px;
    z-index: 2;
  }

  .ll-close-control .ll-close {
    position: static;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
  }

  .ll-close-tip {
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    width: max-content;
    max-width: min(230px, calc(100vw - 56px));
    padding: 8px 10px;
    border-radius: 5px;
    background: #18251f;
    color: #fff;
    box-shadow: 0 8px 24px #0003;
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.35;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-3px);
    transition:
      opacity 120ms ease,
      transform 120ms ease,
      visibility 120ms ease;
  }

  .ll-close-tip[hidden] {
    display: none;
  }

  .ll-close-control:hover .ll-close-tip,
  .ll-close-control:focus-within .ll-close-tip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>

<style is:global>
  /* The base modal width lives in the client stylesheet; override here so the
     refreshed component carries the wider layout into every review build. */
  .ll-review__bar {
    flex-wrap: wrap;
  }

  .ll-review__research-notice {
    border-left: 3px solid #a66b16;
    padding: 6px 10px;
    background: #fff4db;
    color: #5b3d13;
    font-size: 0.78rem;
    line-height: 1.4;
    max-width: min(440px, 100%);
    min-width: 0;
  }

  .ll-review__modal .ll-review__dialog {
    width: min(800px, 100%);
    padding: clamp(22px, 3vw, 34px);
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .ll-parts {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 0 0 18px;
  }

  .ll-part-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    border: 1px solid #cfd8cf;
    border-radius: 999px;
    padding: 8px 15px;
    background: #fff;
    color: #38544a;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 650;
    cursor: pointer;
    transition:
      border-color 120ms ease,
      background 120ms ease,
      color 120ms ease;
  }

  .ll-part-chip:hover {
    border-color: #7fa891;
    color: #1e5b47;
  }

  .ll-part-chip[aria-pressed="true"] {
    border-color: #2f6b53;
    background: #e9f4ec;
    color: #17503b;
    box-shadow: inset 0 0 0 1px #2f6b53;
  }

  .ll-part-chip__mark {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border: 1.5px solid #b9c8bd;
    border-radius: 50%;
    background: #eef4ee;
    color: #fff;
    font-size: 0.6rem;
    font-weight: 900;
    line-height: 1;
  }

  .ll-part-chip__mark::after {
    content: "✓";
    opacity: 0;
  }

  .ll-part-chip[aria-pressed="true"] .ll-part-chip__mark {
    border-color: #2f6b53;
    background: #2f6b53;
  }

  .ll-part-chip[aria-pressed="true"] .ll-part-chip__mark::after {
    opacity: 1;
  }

  .ll-part {
    margin: 0 0 16px;
    padding: 18px;
    border: 1px solid #dce5dd;
    border-radius: 14px;
    background: #fbfdfb;
  }

  .ll-part__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .ll-part h3,
  .ll-client-fields h3 {
    margin: 0;
    font-size: 0.95rem;
    color: #1f3d33;
  }

  .ll-part__off {
    border: 0;
    padding: 2px 0;
    background: none;
    color: #75867c;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .ll-part__off:hover {
    color: #8f2118;
  }

  .ll-part label,
  .ll-client-fields label {
    display: block;
    margin-top: 10px;
    font-size: 0.8rem;
    font-weight: 650;
    color: #304c43;
  }

  .ll-part input[type="file"],
  .ll-client-fields input[type="file"] {
    width: 100%;
    margin-top: 5px;
  }

  .ll-part textarea,
  .ll-client-fields textarea,
  .ll-client-fields select {
    width: 100%;
    margin-top: 5px;
    font: inherit;
    font-weight: 400;
    padding: 8px 10px;
    border: 1px solid #cfd8cf;
    border-radius: 8px;
    resize: vertical;
  }

  .ll-part input[type="email"],
  .ll-client-fields input[type="email"] {
    width: 100%;
    margin-top: 5px;
  }

  .ll-part textarea,
  .ll-client-fields textarea {
    min-height: 76px;
  }

  .ll-part__choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }

  .ll-choice {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 14px;
    border: 1px solid #e0e8e1;
    border-radius: 12px;
    background: #fff;
  }

  .ll-choice__title {
    font-size: 0.83rem;
    font-weight: 750;
    color: #24443a;
  }

  .ll-choice__hint {
    font-size: 0.74rem;
    color: #68766f;
  }

  .ll-choice__file {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin-top: auto;
    padding: 11px 14px;
    border: 1.5px dashed #b9cdbd;
    border-radius: 10px;
    background: #f6faf6;
    color: #1e5b47;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
  }

  .ll-choice__file:hover {
    border-color: #2f6b53;
    background: #eef6ef;
  }

  .ll-choice__file:focus-within {
    outline: 2px solid #2f6b53;
    outline-offset: 2px;
  }

  .ll-choice__file input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .ll-choice label {
    margin-top: 0;
  }

  .ll-choice .ll-generate {
    margin-top: auto;
    align-self: flex-start;
  }

  .ll-attachment {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 12px 0 0;
    padding: 9px;
    border: 1px solid #dce5dd;
    border-radius: 12px;
    background: #fff;
  }

  .ll-attachment__thumb {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 120px;
    height: 90px;
    border: 1px solid #e6ece6;
    border-radius: 9px;
    overflow: hidden;
    background:
      repeating-conic-gradient(#f0f3f0 0% 25%, #ffffff 0% 50%) 50% / 16px 16px;
  }

  .ll-attachment__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ll-attachment__fallback {
    padding: 4px;
    color: #8a978f;
    font-size: 0.66rem;
    font-weight: 700;
    text-align: center;
  }

  .ll-attachment__meta {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .ll-attachment__badge {
    justify-self: start;
    padding: 3px 8px;
    border-radius: 999px;
    background: #e9f4ec;
    color: #1e5b47;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .ll-attachment__name {
    display: -webkit-box;
    overflow: hidden;
    color: #33473f;
    font-size: 0.85rem;
    font-weight: 600;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .ll-attachment__remove {
    justify-self: start;
    margin-top: 2px;
    border: 0;
    padding: 0;
    background: none;
    color: #8f2118;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  .ll-attachment--busy {
    border-style: dashed;
  }

  .ll-attachment__thumb--skeleton {
    background: linear-gradient(100deg, #eef2ee 30%, #f7faf7 50%, #eef2ee 70%);
    background-size: 200% 100%;
    animation: ll-shimmer 1.2s linear infinite;
  }

  @keyframes ll-shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  .ll-part-status {
    margin: 9px 0 0;
    font-size: 0.78rem;
    font-weight: 550;
    color: #52645b;
  }

  .ll-part-status.is-success {
    color: #1e5b47;
  }

  .ll-part-status.is-error {
    color: #9a3412;
  }

  .ll-generate {
    margin-top: 10px;
    border: 1px solid #367a65;
    border-radius: 8px;
    padding: 8px 12px;
    background: #eff7ee;
    color: #1e5b47;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .ll-generate:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .ll-toggle {
    display: flex !important;
    align-items: center;
    gap: 8px;
    font-weight: 600 !important;
  }

  .ll-toggle input {
    width: 15px;
    height: 15px;
    accent-color: #2f6b53;
  }

  .ll-colors {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }

  .ll-part .ll-color,
  .ll-client-fields .ll-color {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 9px;
    padding: 7px 9px;
    border: 1px solid #e4ebe4;
    border-radius: 9px;
    background: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    color: #304c43;
  }

  .ll-color input[type="checkbox"] {
    width: 15px;
    height: 15px;
    accent-color: #2f6b53;
  }

  .ll-color input[type="color"] {
    width: 34px;
    height: 26px;
    padding: 0;
    border: 1px solid #cfd8cf;
    border-radius: 7px;
    background: none;
    cursor: pointer;
  }

  .ll-color input[type="color"]:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .ll-color code {
    justify-self: end;
    font-size: 0.7rem;
    color: #68766f;
  }

  .ll-advanced {
    margin-top: 10px;
    border: 0;
    padding: 0;
    background: none;
    color: #1e5b47;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }

  .ll-client-fields {
    display: grid;
    gap: 4px;
  }

  .ll-parts[hidden],
  .ll-part-sections[hidden],
  .ll-client-fields[hidden],
  .ll-part[hidden],
  .ll-attachment[hidden],
  .ll-client-fields [hidden] {
    display: none !important;
  }

  @media (max-width: 620px) {
    .ll-review__research-notice {
      flex: 1 1 100%;
    }

    .ll-part__choices {
      grid-template-columns: 1fr;
    }

    .ll-review__modal .ll-review__dialog {
      width: 100%;
      padding: 20px 16px;
    }
  }

</style>

<script is:inline define:vars={{ launchloomUrl, publishReady, webResearchComplete, pendingCoverage, completedCityCount, confirmedCityCount, factNotice, factBlocked, palette }}>
  const root = document.querySelector("#ll-review");
  const diagnosticPreview = root?.getAttribute("data-diagnostic-preview") === "true";
  const token = new URLSearchParams(window.location.search).get("review");
  const claims = (() => {
    try {
      const encoded = token?.split(".")[0]?.replace(/-/g, "+").replace(/_/g, "/") || "";
      return JSON.parse(atob(encoded.padEnd(encoded.length + ((4 - encoded.length % 4) % 4), "=")));
    } catch { return null; }
  })();
  const developer = claims?.stage === "developer";
  const diagnosticReview = diagnosticPreview && developer && Boolean(claims?.creativeRepairSessionId);
  if (!root || !token || !launchloomUrl || !["developer", "client"].includes(claims?.stage) || (diagnosticPreview && !diagnosticReview)) {
    root?.setAttribute("hidden", "");
  } else {
    const labelFor = (id) =>
      IMAGE_PARTS.find((part) => part.id === id)?.label ||
      TEXT_PARTS.find((part) => part.id === id)?.label ||
      (id === "colors" ? "Colors" : id);
    const compressFeedbackImage = async (file) => {
      if (!file.type.startsWith("image/") || file.size < 900_000) return file;
      try {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, 1800 / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(bitmap.width * scale));
        canvas.height = Math.max(1, Math.round(bitmap.height * scale));
        canvas.getContext("2d")?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, "image/webp", 0.82));
        return blob
          ? new File([blob], file.name.replace(/\.[^.]+$/, ".webp"), { type: "image/webp" })
          : file;
      } catch {
        return file;
      }
    };
    if (!diagnosticPreview) root.removeAttribute("hidden");
    const modal = root.querySelector(".ll-review__modal");
    const open = root.querySelector(".ll-feedback-open");
    const close = root.querySelector(".ll-close");
    const closeTip = root.querySelector(".ll-close-tip");
    const cancel = root.querySelector(".ll-cancel");
    const approve = root.querySelector(".ll-approve");
    const fieldNotice = root.querySelector(".ll-review__field-notice");
    const sendAnyway = root.querySelector(".ll-send-anyway");
    const overrideDialog = root.querySelector(".ll-override-dialog");
    const overrideCancel = root.querySelector(".ll-override-cancel");
    const overrideConfirm = root.querySelector(".ll-override-confirm");
    const overrideStatus = root.querySelector(".ll-override-status");
    const form = root.querySelector(".ll-feedback-form");
    const status = root.querySelector(".ll-feedback-status");
    const emailInput = form.querySelector('input[name="email"]');
    const commentInput = form.querySelector('textarea[name="comment"]');
    const send = form.querySelector(".ll-send");
    const partsHost = root.querySelector(".ll-parts");
    const sectionsHost = root.querySelector(".ll-part-sections");
    const clientFields = root.querySelector(".ll-client-fields");
    let feedbackSubmissionId = "";

    const setStatusText = (text) => { status.textContent = text; };
    const updateDraftHint = () => {
      const hasDraft = Boolean(
        commentInput.value.trim() ||
        (developer && selectedParts.size) ||
        (developer && Object.values(notes).some((value) => String(value || "").trim())) ||
        (developer && Object.values(colorChoices).some((choice) => choice.enabled)) ||
        (!developer && (clientFile || clientGenerated || clientColors.some((choice) => choice.enabled)))
      );
      closeTip.toggleAttribute("hidden", !hasDraft);
      if (hasDraft) close.setAttribute("aria-describedby", "ll-close-draft-tip");
      else close.removeAttribute("aria-describedby");
    };

    // ---------------------------------------------------------------- client
    const CLIENT_COLORS = [
      { id: "primary", label: "Main brand color", fallback: "#205d51" },
      { id: "surface", label: "Page background", fallback: "#f8f6f0" },
    ];
    const CLIENT_PHOTO_TARGETS = [
      { id: "hero", label: "Main image at the top" },
      { id: "secondary", label: "About image" },
      { id: "tertiary", label: "Gallery photo" },
      { id: "team", label: "Team photo" },
    ];
    let clientCategory = "text";
    let clientTarget = "hero";
    let clientFile = null;
    let clientGenerated = null;
    const clientColors = CLIENT_COLORS.map((role) => ({
      ...role,
      enabled: false,
      hex: /^#[0-9a-f]{6}$/i.test(palette[role.id] || "") ? palette[role.id] : role.fallback,
    }));
    let clientCategorySelect = null;
    let clientTargetSelect = null;
    let clientImageHost = null;
    let clientColorHost = null;
    let clientFileInput = null;
    let clientPrompt = null;
    let clientGenerateButton = null;
    let clientPreview = null;
    let clientPreviewImage = null;
    let clientPreviewBadge = null;
    let clientPreviewName = null;
    let clientPreviewFallback = null;
    let clientBusyCard = null;
    let clientStatus = null;
    let clientPreviewUrl = "";
    let clientColorSection = null;
    let clientGenerating = false;

    function setClientImageVisibility() {
      const imageCategory = clientCategory === "logo" || clientCategory === "photos";
      if (clientImageHost) clientImageHost.hidden = !imageCategory;
      if (clientColorSection) clientColorSection.hidden = clientCategory !== "color";
    }

    function setClientStatus(text, error = false) {
      if (!clientStatus) return;
      clientStatus.textContent = text;
      clientStatus.classList.toggle("is-error", Boolean(error));
      clientStatus.classList.toggle("is-success", Boolean(text) && !error);
    }

    function renderClientColors() {
      if (!clientColorHost) return;
      clientColorHost.innerHTML = "";
      for (const role of clientColors) {
        const row = document.createElement("label");
        row.className = "ll-color";
        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.checked = role.enabled;
        const picker = document.createElement("input");
        picker.type = "color";
        picker.value = role.hex;
        picker.disabled = !role.enabled;
        const code = document.createElement("code");
        code.textContent = role.hex.toUpperCase();
        const sync = () => {
          picker.value = role.hex;
          picker.disabled = !role.enabled;
          code.textContent = role.hex.toUpperCase();
        };
        checkbox.addEventListener("change", () => {
          role.enabled = checkbox.checked;
          sync();
          updateDraftHint();
        });
        picker.addEventListener("input", () => {
          role.hex = picker.value;
          role.enabled = true;
          checkbox.checked = true;
          sync();
          updateDraftHint();
        });
        const label = document.createElement("span");
        label.textContent = role.label;
        row.append(checkbox, label, picker, code);
        clientColorHost.append(row);
      }
    }

    function renderClientTargets() {
      if (!clientTargetSelect) return;
      const options = clientCategory === "logo"
        ? [{ id: "logo", label: "Logo or brand mark" }]
        : CLIENT_PHOTO_TARGETS;
      clientTargetSelect.innerHTML = "";
      for (const option of options) {
        const element = document.createElement("option");
        element.value = option.id;
        element.textContent = option.label;
        clientTargetSelect.append(element);
      }
      clientTarget = options[0].id;
      clientTargetSelect.value = clientTarget;
    }

    function renderClientPreview() {
      if (!clientPreview) return;
      const chosen = Boolean(clientGenerated || clientFile);
      clientPreview.hidden = !chosen || clientGenerating;
      if (clientBusyCard) clientBusyCard.hidden = !(clientGenerating && !chosen);
      if (clientPreviewUrl) {
        URL.revokeObjectURL(clientPreviewUrl);
        clientPreviewUrl = "";
      }
      if (!chosen) return;
      let src = "";
      if (clientGenerated) src = clientGenerated.url;
      else {
        clientPreviewUrl = URL.createObjectURL(clientFile);
        src = clientPreviewUrl;
      }
      if (clientPreviewImage.getAttribute("src") !== src) {
        clientPreviewImage.hidden = false;
        clientPreviewFallback.hidden = true;
        clientPreviewImage.onerror = () => {
          clientPreviewImage.hidden = true;
          clientPreviewFallback.hidden = false;
        };
        clientPreviewImage.src = src;
      }
      clientPreviewBadge.textContent = clientGenerated
        ? "Created for you"
        : "Your photo";
      clientPreviewName.textContent = clientGenerated
        ? clientGenerated.prompt || ""
        : clientFile?.name || "";
    }

