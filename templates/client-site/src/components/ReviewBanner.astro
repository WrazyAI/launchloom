        });
        section.querySelector(`[data-part-clear="${part.id}"]`).addEventListener("click", () => {
          drafts[part.id].upload = undefined;
          drafts[part.id].generated = undefined;
          drafts[part.id].status = "";
          drafts[part.id].error = false;
          setStatus(part.id, "");
          renderPreview(part.id);
          updateDraftHint();
        });
        return section;
      };
      for (const part of IMAGE_PARTS) sectionsHost.append(imageSection(part));

      const textSection = (part) => {
        const section = document.createElement("section");
        section.className = "ll-part";
        section.dataset.partSection = part.id;
        section.hidden = true;
        section.innerHTML = `<header class="ll-part__head"><h3>${part.label}</h3><button type="button" class="ll-part__off" data-part-off="${part.id}">Turn off</button></header>`;
        section.querySelector(`[data-part-off="${part.id}"]`).addEventListener("click", () => {
          root.querySelector(`[data-part="${part.id}"]`)?.click();
        });
        if (part.id === "navigation") {
          const toggle = document.createElement("label");
          toggle.className = "ll-toggle";
          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.addEventListener("change", () => {
            showBrandName = checkbox.checked;
            updateDraftHint();
          });
          toggle.append(checkbox, "Show the business name in the header");
          section.append(toggle);
        }
        section.append(
          noteField(
            part.id,
            part.id === "navigation" ? "Note (optional)" : "What should change?",
            part.hint,
          ),
        );
        return section;
      };
      for (const part of TEXT_PARTS) sectionsHost.append(textSection(part));

      const colorsSection = () => {
        const section = document.createElement("section");
        section.className = "ll-part";
        section.dataset.partSection = "colors";
        section.hidden = true;
        section.innerHTML = `<header class="ll-part__head"><h3>Colors</h3></header><p class="ll-part-status">Pick the colors you like. We will adjust the rest so text stays easy to read.</p><div class="ll-colors"></div><button type="button" class="ll-advanced">More color options</button>`;
        const host = section.querySelector(".ll-colors");
        const renderRoles = () => {
          host.innerHTML = "";
          for (const role of COLOR_ROLES.filter((candidate) => showAdvancedColors || !candidate.advanced)) {
            const row = document.createElement("label");
            row.className = "ll-color";
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.checked = colorChoices[role.id].enabled;
            const picker = document.createElement("input");
            picker.type = "color";
            picker.value = colorChoices[role.id].hex;
            picker.disabled = !colorChoices[role.id].enabled;
            const code = document.createElement("code");
            code.textContent = colorChoices[role.id].hex.toUpperCase();
            const sync = () => {
              picker.value = colorChoices[role.id].hex;
              picker.disabled = !colorChoices[role.id].enabled;
              code.textContent = colorChoices[role.id].hex.toUpperCase();
            };
            checkbox.addEventListener("change", () => {
              colorChoices[role.id].enabled = checkbox.checked;
              sync();
              updateDraftHint();
            });
            picker.addEventListener("input", () => {
              colorChoices[role.id].hex = picker.value;
              colorChoices[role.id].enabled = true;
              checkbox.checked = true;
              sync();
              updateDraftHint();
            });
            const label = document.createElement("span");
            label.textContent = role.label;
            row.append(checkbox, label, picker, code);
            host.append(row);
          }
        };
        section.querySelector(".ll-advanced").addEventListener("click", (event) => {
          showAdvancedColors = !showAdvancedColors;
          event.currentTarget.textContent = showAdvancedColors ? "Fewer color options" : "More color options";
          renderRoles();
        });
        renderColorRoles = renderRoles;
        renderRoles();
        return section;
      };
      sectionsHost.append(colorsSection());
    }

    async function submitDeveloperFeedback(submittedEmail) {
      const attachments = [];
      const colorSelections = [];
      const textLines = [];
      for (const id of selectedParts) {
        const imagePart = IMAGE_PARTS.find((part) => part.id === id);
        if (imagePart) {
          const draft = drafts[id];
          const chosen = draft.generated || draft.upload;
          if (chosen) {
            attachments.push({
              target: id,
              kind: draft.generated ? "generated" : "upload",
              url: chosen.url,
              ...(draft.generated ? { prompt: draft.generated.prompt, model: draft.generated.model } : {}),
            });
          }
          const note = String(notes[id] || "").trim();
          if (note) textLines.push(`${imagePart.label}: ${note}`);
          if (!chosen && !note) {
            setStatusText(`Add an image or a note for ${imagePart.label}, or turn it off.`);
            return false;
          }
          continue;
        }
        if (id === "colors") continue;
        const textPart = TEXT_PARTS.find((part) => part.id === id);
        const note = String(notes[id] || "").trim();
        if (id === "navigation" && showBrandName) textLines.push("Show the business name in the header.");
        if (note) textLines.push(`${textPart.label}: ${note}`);
        if (!note && !(id === "navigation" && showBrandName)) {
          setStatusText(`Add a note for ${textPart.label}, or turn it off.`);
          return false;
        }
      }
      for (const role of COLOR_ROLES) {
        const choice = colorChoices[role.id];
        if (choice.enabled) colorSelections.push({ role: role.id, hex: choice.hex.toLowerCase() });
      }
      if (selectedParts.has("colors") && !colorSelections.length) {
        setStatusText("Pick at least one color, or turn off Colors.");
        return false;
      }
      const generalNote = String(commentInput.value || "").trim();
      const comment = [textLines.join("\n"), generalNote].filter(Boolean).join("\n\n");
      if (!comment && !attachments.length && !colorSelections.length) {
        setStatusText("Add a note, an image, or a color first.");
        return false;
      }
      try {
        const endpoint = diagnosticReview ? "/api/creative-repair" : "/api/feedback";
        const payload = {
          token,
          ...(diagnosticReview ? { action: "feedback" } : {}),
          email: submittedEmail,
          comment,
          category: [...selectedParts].map(labelFor).join(", ").slice(0, 80),
          pageUrl: window.location.href,
          submissionId: feedbackSubmissionId,
          details: { attachments, colors: colorSelections },
        };
        const response = await fetch(`${launchloomUrl}${endpoint}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          setStatusText(result.error || "Feedback could not be sent.");
          return false;
        }
        setStatusText(
          diagnosticReview
            ? result.queueStatus === "queued"
              ? "Saved as the starting point. Your changes are queued; the client has not received this version."
              : "Saved as the starting point. Your changes are being applied; the client has not received this version."
            : result.queueStatus === "queued"
              ? "Queued. Your request will start after the current update."
              : "Received. A revised developer preview will be sent shortly.",
        );
        if (diagnosticReview) {
          fieldNotice.hidden = false;
          fieldNotice.textContent = "Your changes are saved as the starting point. The client has not received this preview.";
          open.disabled = true;
          sendAnyway.disabled = true;
          sendAnyway.textContent = "Revision in progress";
        }
        feedbackSubmissionId = "";
        form.reset();
        selectedParts.clear();
        for (const id of Object.keys(notes)) notes[id] = "";
        root.querySelectorAll("[data-part-note]").forEach((textarea) => { textarea.value = ""; });
        root.querySelectorAll("[data-part-prompt]").forEach((textarea) => { textarea.value = ""; });
        root.querySelectorAll('input[type="file"]').forEach((input) => { input.value = ""; });
        for (const id of Object.keys(drafts)) {
          drafts[id] = { status: "", busy: false };
          setStatus(id, "");
          renderPreview(id);
        }
        for (const role of COLOR_ROLES) colorChoices[role.id].enabled = false;
        showBrandName = false;
        root.querySelectorAll(".ll-part-chip").forEach((button) => {
          button.classList.remove("is-active");
          button.setAttribute("aria-pressed", "false");
        });
        root.querySelectorAll("[data-part-section]").forEach((section) => { section.hidden = true; });
        root.querySelectorAll(".ll-toggle input").forEach((input) => { input.checked = false; });
        showAdvancedColors = false;
        const advancedButton = sectionsHost.querySelector(".ll-advanced");
        if (advancedButton) advancedButton.textContent = "More color options";
        renderColorRoles();
        updateDraftHint();
        return true;
      } catch {
        setStatusText("Feedback could not be sent.");
        return false;
      }
    }

    // ------------------------------------------------------------ shared UI
    if (developer) {
      buildDeveloperForm();
    } else {
      partsHost.hidden = true;
      sectionsHost.hidden = true;
      buildClientForm();
    }

    root.querySelector(".ll-review__summary").innerHTML = diagnosticReview
      ? "<span aria-hidden=\"true\">▣</span> This is an internal preview. The client has not received it."
      : developer
      ? "<span aria-hidden=\"true\">▣</span> Internal developer review. Approve before the client sees this."
      : "<span aria-hidden=\"true\">▣</span> Your website is live. Tell us what you would like changed.";
    root.querySelector(".ll-review__intro").textContent = developer
      ? diagnosticReview
        ? "Some automatic quality checks did not pass. Send your changes, or choose to send this exact preview anyway."
        : "Leave clear internal notes, or approve this exact version to publish and invite the client."
      : "Request a small correction such as a logo, photo, color, contact detail, or wording change. You can upload a new image or create one.";
    root.querySelector(".ll-general-note").firstChild.textContent = developer
      ? "Anything else?"
      : "Describe the small change";
    commentInput.placeholder = developer
      ? "For example: Keep the overall direction, but make the service choices easier to scan."
      : clientCategory === "text"
        ? 'Quote the exact text and replacement, for example: Replace text "Same day service" with "Prompt scheduling".'
        : "Tell us what you would like changed. Bigger redesigns are handled separately.";
    approve.toggleAttribute("hidden", !developer);
    const factNoticeElement = root.querySelector(".ll-review__fact-notice");
    if (developer && factNotice && factNoticeElement) {
      factNoticeElement.textContent = factNotice;
      factNoticeElement.hidden = false;
    }
    if (developer && webResearchComplete) {
      const researchNotice = root.querySelector(".ll-review__research-notice");
      researchNotice.hidden = false;
      researchNotice.textContent = "Web research complete. Measured SEO data unavailable. Developer approval is available.";
      root.dataset.researchMode = "web-researched";
    }
    if (developer && pendingCoverage) {
      const researchNotice = root.querySelector(".ll-review__research-notice");
      researchNotice.hidden = false;
      researchNotice.textContent = `${completedCityCount} of ${confirmedCityCount} confirmed cities have completed research. Remaining city research is pending within the shared budget. ${publishReady ? "Primary-city research passed the approval checks." : "Required primary-city research is incomplete; publishing is blocked."}`;
      root.dataset.coverageResearch = "partial";
    }
    if (diagnosticReview) {
      approve.setAttribute("hidden", "");
      fieldNotice.textContent = "No client release happens unless you confirm the not-recommended action.";
      sendAnyway.removeAttribute("hidden");
      if (!publishReady) {
        sendAnyway.disabled = true;
        sendAnyway.title = "Business facts or SEO research are incomplete. Publishing remains blocked.";
      }
      fetch(`${launchloomUrl}/api/creative-repair`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, action: "status", pageUrl: window.location.href }) })
        .then(async (response) => {
          const result = await response.json();
          if (!response.ok || !result.previewUrl || new URL(result.previewUrl).origin !== window.location.origin) return;
          fieldNotice.hidden = false;
          root.removeAttribute("hidden");
          if (!publishReady) {
            sendAnyway.disabled = true;
            sendAnyway.title = "Business facts or SEO research are incomplete. Publishing remains blocked.";
            fieldNotice.textContent = "This preview missed the visual checks. Business facts or SEO research are incomplete, so client release remains blocked.";
          } else if (["dispatching", "queued", "running"].includes(result.status) || (result.reviewQueue && result.reviewQueue !== "clear")) {
            open.disabled = true;
            sendAnyway.disabled = true;
            sendAnyway.textContent = "Revision in progress";
            fieldNotice.textContent = "This version is saved as the starting point. A developer update is in progress; the client has not received this preview.";
          } else if (["dispatching", "published"].includes(result.overrideStatus)) {
            sendAnyway.disabled = true;
            sendAnyway.textContent = result.overrideStatus === "published" ? "Client release already queued" : "Client release request is processing";
          } else if (result.overrideStatus === "failed") {
            fieldNotice.textContent = result.overrideFailure
              ? `The last client-release attempt failed: ${result.overrideFailure}`
              : "The last client-release attempt failed. You can retry after reviewing this exact preview.";
          }
        })
        .catch(() => root.setAttribute("hidden", ""));
    } else if (developer && !publishReady) {
      root.querySelector(".ll-review__summary").textContent = factBlocked
        ? "Internal review. Business facts need confirmation, so publishing is blocked."
        : "Internal review. SEO research is incomplete, so publishing is blocked.";
      approve.disabled = true;
      approve.textContent = factBlocked ? "Business facts required" : "SEO research required";
      approve.title = factBlocked ? "Resolve the missing or contradictory facts in the client brief." : "Rerun the intake after SEO research succeeds.";
    }
    const setModal = (visible) => {
      modal.toggleAttribute("hidden", !visible);
      if (visible) window.dispatchEvent(new CustomEvent("launchloom:overlay-open", { detail: { id: "review" } }));
    };
    open.addEventListener("click", () => setModal(true));
    sendAnyway.addEventListener("click", () => {
      overrideStatus.textContent = "";
      if (typeof overrideDialog.showModal === "function") overrideDialog.showModal();
    });
    overrideCancel.addEventListener("click", () => overrideDialog.close());
    overrideConfirm.addEventListener("click", async () => {
      overrideConfirm.disabled = true;
      sendAnyway.disabled = true;
      overrideStatus.textContent = "Requesting release for this exact preview…";
      try {
        const response = await fetch(`${launchloomUrl}/api/creative-repair`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, action: "send-anyway", email: String(claims.reviewerEmail || ""), pageUrl: window.location.href, confirmed: true }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "The client release could not be queued.");
        overrideStatus.textContent = "Confirmed. Client publication is queued. Production release checks will still run.";
        overrideConfirm.textContent = "Release queued";
        sendAnyway.textContent = "Client release queued";
        open.disabled = true;
      } catch (error) {
        overrideStatus.textContent = error instanceof Error ? error.message : "The client release could not be queued.";
        overrideConfirm.disabled = false;
        sendAnyway.disabled = !publishReady;
      }
    });
    close.addEventListener("click", () => setModal(false));
    cancel.addEventListener("click", () => setModal(false));
    window.addEventListener("launchloom:overlay-open", (event) => {
      if (event.detail?.id !== "review") setModal(false);
    });
    emailInput.addEventListener("input", () => { emailInput.setCustomValidity(""); updateDraftHint(); });
    commentInput.addEventListener("input", updateDraftHint);
    const verifyEmail = (submittedEmail) => {
      if (submittedEmail === String(claims.reviewerEmail || "").toLowerCase()) return true;
      const message = "Use the same email address that received this review link.";
      emailInput.setCustomValidity(message); emailInput.reportValidity(); status.textContent = message; return false;
    };
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const submittedEmail = String(data.get("email") || "").trim().toLowerCase();
      if (!verifyEmail(submittedEmail)) return;
      feedbackSubmissionId ||= crypto.randomUUID();
      send.disabled = true;
      status.textContent = "Sending…";
      try {
        const ok = developer
          ? await submitDeveloperFeedback(submittedEmail)
          : await submitClientFeedback(submittedEmail);
        if (!ok) status.textContent = status.textContent || "Feedback could not be sent.";
      } finally {
        if (!status.textContent || status.textContent === "Sending…") status.textContent = "Feedback could not be sent.";
        send.disabled = false;
      }
    });
    approve.addEventListener("click", async () => {
      if (!window.confirm("Approve this exact version, publish it, and send the client their review link?")) return;
      approve.disabled = true; approve.textContent = "Publishing…";
      try {
        // The developer identity is already bound to this signed link. Unlike
        // feedback, approval should not force the developer through the form.
        const response = await fetch(`${launchloomUrl}/api/approval`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, email: String(claims.reviewerEmail || ""), pageUrl: window.location.href }) });
        const result = await response.json(); if (!response.ok) throw new Error(result.error || "Approval could not be recorded.");
        approve.textContent = "Approved ✓";
      } catch (error) { approve.disabled = false; approve.textContent = error instanceof Error ? error.message : "Approve & send to client"; }
    });
  }
</script>
