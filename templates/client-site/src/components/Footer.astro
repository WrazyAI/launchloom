---
import site, { phoneHref } from "../lib/site";
---

<footer class="footer"><div class="wrap footer-grid"><div><a class:list={["wordmark", { "wordmark--logo": Boolean(site.assets?.logo) }]} href="/">{site.assets?.logo && <img src={site.assets.logo} alt="" />}<span class="wordmark__name">{site.business.name}</span></a><p>{site.business.description}</p></div><div><strong>Contact</strong><a href={phoneHref(site.business.phone)}>{site.business.phone}</a><a href={`mailto:${site.business.email}`}>{site.business.email}</a></div><div><strong>Visit</strong><p>{site.business.address}</p><p>{site.business.hours}</p></div></div><div class="wrap legal">© {new Date().getFullYear()} {site.business.name}. All rights reserved.</div></footer>
