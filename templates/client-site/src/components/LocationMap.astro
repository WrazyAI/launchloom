---
import site, { locationMap } from "../lib/site";

const approximate = locationMap.kind === "approximate";
const offlineEvidence = import.meta.env.PUBLIC_CREATIVE_JUDGE === "true";
const locationLabel = locationMap.address || site.business.name;
const locationHeading = /[.!?]$/.test(site.business.name)
  ? `Find ${site.business.name}`
  : `Find ${site.business.name}.`;
---

{locationMap.available && (
  <section class="location-map-section" id="location" data-conversion-feature="location-map" data-location-kind={locationMap.kind} data-runtime-provider-omitted={offlineEvidence && locationMap.embedHref ? "location-map" : undefined}>
    <div class="wrap location-map-grid">
      <div class="location-map-copy">
        <span class="kicker">{approximate ? "Approximate location" : "Visit us"}</span>
        <h2>{approximate ? `Area waypoint: ${locationMap.waypoint}` : locationHeading}</h2>
        {approximate && <p>This map shows the general area, not a business address.</p>}
        {locationMap.address && <p>{locationMap.address}</p>}
        {!approximate && site.business.hours && <p class="location-map-hours">{site.business.hours}</p>}
        <a class="cta" href={locationMap.directionsHref} target="_blank" rel="noopener noreferrer">
          {approximate ? "View area in Google Maps" : "Open in Google Maps"} <span aria-hidden="true">↗</span>
        </a>
      </div>
      {locationMap.embedHref && <div class="location-map-frame" aria-hidden={offlineEvidence || undefined}>
        {!offlineEvidence && <iframe
          src={locationMap.embedHref}
          title={approximate ? `Approximate area map for ${locationMap.waypoint}` : locationMap.address ? `Map showing ${site.business.name} at ${locationLabel}` : `Map showing ${locationLabel}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />}
      </div>}
    </div>
  </section>
)}
