---
import site, { phoneHref } from "../lib/site";
import { defaultRecipe } from "../lib/page-recipe";
const sections = site.design?.sections || [];
const recipe = site.design?.recipe || defaultRecipe(site);
const sectionId = (type: string, fallback?: string) =>
  sections.find((section) => section.type === type)?.id || fallback;
const servicesId = sectionId("services", "services");
const aboutId = sectionId("about", "about");
const coverageId = sectionId("coverage");
const contactId = sectionId("contact", "contact");
---

<header class:list={["header-shell", `header-${recipe}`]}><div class="header wrap">
  <a class:list={["wordmark", { "wordmark--logo": Boolean(site.assets?.logo) }]} href="/">
    {site.assets?.logo && <img src={site.assets.logo} alt="" />}
    <span class="wordmark__name">{site.business.name}</span>
  </a>
  <nav aria-label="Main navigation"><a href={`/#${servicesId}`}>Services</a>{aboutId && <a href={`/#${aboutId}`}>Approach</a>}{coverageId && <a href={`/#${coverageId}`}>Service areas</a>}<a href={`/#${contactId}`}>Contact</a></nav>
  {site.business.phone && <a class="header-call" href={phoneHref(site.business.phone)}><span>{recipe === "local-trades" ? "Call for service" : "Call us"}</span>{site.business.phone}</a>}
</div></header>
