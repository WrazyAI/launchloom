---
import { serviceHref } from "../../lib/site";
import { phoneHref, primaryCtaHref } from "../../lib/site";
import type { ExperienceBlueprintV2, ExperienceContent } from "../../lib/experience-pack";
import LeadForm from "../LeadForm.astro";
import LocationMap from "../LocationMap.astro";
import SocialProof from "../SocialProof.astro";
import ReferencePackCredit from "./ReferencePackCredit.astro";

interface Props { program: ExperienceBlueprintV2; content: ExperienceContent }
const { program, content } = Astro.props;
const { brand, hero, services, proof, process, faqs, copy } = content;
---

<div class="xp-stage" data-experience-pack={program.packId} data-experience-variant={program.variantId} data-layout-fingerprint={program.fingerprint}>
  <header class="xp-stage__header">
    <a class="xp-stage__mark" href="/">{brand.logo ? <img src={brand.logo} alt={brand.name} /> : <strong>{brand.name}</strong>}</a>
    <nav aria-label="Main navigation"><a href="#services">Services</a><a href="#faqs">FAQs</a><a href="#contact">Contact</a></nav>
    {brand.phone && <a class="xp-stage__phone" href={phoneHref(brand.phone)}>{brand.phone}</a>}
  </header>

  <main>
    <section class="xp-stage__hero" id="opening" data-experience-hero>
      <div class="xp-stage__stage">
        <p class="xp-stage__eyebrow">{hero.kicker}</p>
        <h1>{hero.heading}</h1>
        <p class="xp-stage__promise">{hero.body}</p>
        <a class="xp-stage__action" href={primaryCtaHref(Astro.url.pathname)}>{hero.primaryLabel}</a>
      </div>
      <figure class="xp-stage__frame">
        {hero.image ? <img src={hero.image} alt={`${brand.name} care setting`} fetchpriority="high" /> : <div class="xp-stage__art" aria-hidden="true"><span>{brand.name}</span></div>}
        {hero.offer && <figcaption>{hero.offer}</figcaption>}
      </figure>
    </section>

    <aside class="xp-stage__destination-ribbon" aria-label="Explore the practice">
      <p>Four doors into the same practice.</p>
      <ol>
        <li><a href="#services">Care</a></li>
        <li><a href="#about">Approach</a></li>
        <li><a href="#faqs">FAQs</a></li>
        <li><a href="#contact">Contact</a></li>
      </ol>
    </aside>

    <section class="xp-stage__services" id="services">
      <header><p class="xp-stage__eyebrow">Care, in clear steps</p><h2>{copy.servicesHeading || "A considered kind of care."}</h2><p>{copy.servicesIntro || "Every service description stays factual and specific."}</p></header>
      <div class="xp-stage__panels">
        {services.map((service, index) => <a href={serviceHref(service.slug)}><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><div><h3>{service.name}</h3><p>{service.description}</p></div><b aria-hidden="true">↗</b></a>)}
      </div>
    </section>

    <section class="xp-stage__about" id="about">
      <div>
        <p class="xp-stage__eyebrow">{copy.aboutKicker || "A better first visit"}</p>
        <h2>{copy.aboutHeading || "Know what happens next."}</h2>
        <p>{copy.aboutBody || content.businessDescription}</p>
      </div>
      {process.length > 0 && <ol class="xp-stage__steps">{process.map((step, index) => <li><b aria-hidden="true">{String(index + 1).padStart(2, "0")}</b><span>{step}</span></li>)}</ol>}
    </section>

    {proof.length > 0 && <section class="xp-stage__proof" aria-label="What the practice stands for">{proof.map((item) => <p>{item}</p>)}</section>}

    {content.hasSocialProof && <SocialProof id="social-proof" />}

    <section class="xp-stage__faqs" id="faqs"><header><p class="xp-stage__eyebrow">Good questions belong up front</p><h2>{copy.faqHeading || "Before your visit."}</h2></header><div>{faqs.length > 0 ? faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>) : <p>Questions are welcome. Contact the team to talk through what you need.</p>}</div></section>

    {content.showLocationMap && <LocationMap />}
    <section class="xp-stage__contact" id="contact">
      <div><p class="xp-stage__eyebrow">{copy.contactKicker || "A small first step"}</p><h2>{copy.contactHeading || hero.primaryLabel}</h2><p>{content.businessDescription}</p>{brand.phone && <a href={phoneHref(brand.phone)}>{brand.phone}</a>}</div>
      <LeadForm id="stage-lead" />
    </section>
  </main>
  <footer class="xp-stage__footer"><strong>{brand.name}</strong><span>{brand.serviceAreas.join(" · ")}</span><span>© {new Date().getFullYear()}</span><ReferencePackCredit label="Design language adapted from Dimension by HTML5 UP" href="https://html5up.net/dimension" license="CC BY 3.0" /></footer>
</div>
