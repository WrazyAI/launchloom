---
import { phoneHref, primaryCtaHref } from "../../lib/site";
import type { ExperienceBlueprintV2, ExperienceContent } from "../../lib/experience-pack";
import LeadForm from "../LeadForm.astro";
import LocationMap from "../LocationMap.astro";
import SocialProof from "../SocialProof.astro";

interface Props { program: ExperienceBlueprintV2; content: ExperienceContent }
const { program, content } = Astro.props;
const { brand, hero, services, proof, faqs, copy } = content;
const secondary = hero.secondaryImage;
---

<div class="xp-folio" data-experience-pack={program.packId} data-layout-fingerprint={program.fingerprint}>
  <header class="xp-folio__header">
    <a class="xp-folio__mark" href="/">
      {brand.logo ? <img src={brand.logo} alt="" /> : <span aria-hidden="true">{brand.name.slice(0, 1)}</span>}
      <strong>{brand.name}</strong>
    </a>
    <nav aria-label="Main navigation">
      <a href="#services">Services</a><a href="#faqs">FAQs</a><a href="#contact">Contact</a>
    </nav>
    {brand.phone && <a class="xp-folio__phone" href={phoneHref(brand.phone)}>{brand.phone}</a>}
  </header>

  <main>
    <section class="xp-folio__hero" id="opening">
      <p class="xp-folio__eyebrow">{hero.kicker}</p>
      <h1>{hero.heading}</h1>
      <div class="xp-folio__hero-grid">
        <div class="xp-folio__intro">
          <p>{hero.body}</p>
          <a href={primaryCtaHref(Astro.url.pathname)}>{hero.primaryLabel}<span aria-hidden="true">↗</span></a>
        </div>
        {hero.image ? <figure><img src={hero.image} alt={`${brand.name} work and service context`} fetchpriority="high" /></figure> : <div class="xp-folio__art"><span>{brand.name}</span></div>}
      </div>
    </section>

    <aside class="xp-folio__ribbon" aria-label="Start here">
      <p>{hero.offer || "Bring the questions and constraints that matter to your decision."}</p>
      <a href="#contact">Start a conversation</a>
    </aside>

    <section class="xp-folio__services" id="services">
      <header><p>Selected services</p><h2>{copy.servicesHeading || "Work shaped around the real brief."}</h2></header>
      <div class="xp-folio__service-index">
        {services.map((service) => <a href={`/services/${service.slug}/`}><h3>{service.name}</h3><p>{service.description}</p><span>View service ↗</span></a>)}
      </div>
    </section>

    <section class="xp-folio__story">
      {secondary && <figure><img src={secondary} alt={`${brand.name} service setting`} loading="lazy" /></figure>}
      <div><p class="xp-folio__eyebrow">{copy.aboutKicker || "The work behind the work"}</p><h2>{copy.aboutHeading || "A considered path from question to next step."}</h2><p>{copy.aboutBody || content.businessDescription}</p></div>
    </section>

    {proof.length > 0 && <section class="xp-folio__proof" aria-label="Why choose us">{proof.map((item) => <p>{item}</p>)}</section>}

    {content.hasSocialProof && <SocialProof id="social-proof" />}

    {faqs.length > 0 && <section class="xp-folio__faqs" id="faqs"><header><p>Practical details</p><h2>{copy.faqHeading || "Before we begin."}</h2></header><div>{faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>}

    {content.showLocationMap && <LocationMap />}
    <section class="xp-folio__contact" id="contact">
      <div><p class="xp-folio__eyebrow">{copy.contactKicker || "Begin here"}</p><h2>{copy.contactHeading || hero.primaryLabel}</h2><p>{content.businessDescription}</p>{brand.phone && <a href={phoneHref(brand.phone)}>{brand.phone}</a>}</div>
      <LeadForm id="folio-lead" />
    </section>
  </main>
  <footer class="xp-folio__footer"><strong>{brand.name}</strong><span>{brand.serviceAreas.join(" · ")}</span><span>© {new Date().getFullYear()}</span></footer>
</div>
