---
import site from "../lib/site";
import ReviewBanner from "../components/ReviewBanner.astro";
import QuickAnswers from "../components/QuickAnswers.astro";
import ExitOffer from "../components/ExitOffer.astro";
import "../styles/site.css";

const { title = site.business.name, description = site.business.description, schemas = [] } = Astro.props;
const diagnosticPreview = import.meta.env.PUBLIC_CREATIVE_DIAGNOSTIC === "true";
const noIndex = import.meta.env.PUBLIC_REVIEW_MODE === "true" || diagnosticPreview;
// The approved deployment origin is supplied at build time. A domain in the
// intake is not necessarily connected to Pages and must not become canonical.
const canonical = noIndex ? undefined : new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const openGraphImage = site.images.hero
  ? new URL(site.images.hero, Astro.site ?? Astro.url).href
  : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@type": site.industry === "home-services" ? "HomeAndConstructionBusiness" : "LocalBusiness",
  name: site.business.name,
  description,
  telephone: site.business.phone || undefined,
  email: site.business.email || undefined,
  address: site.business.address || undefined,
  areaServed: site.business.serviceAreas.length ? site.business.serviceAreas : undefined,
  url: canonical,
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
const schemaBlocks = (Array.isArray(schemas) ? schemas : []).map((schema) =>
  JSON.stringify(schema).replace(/</g, "\\u003c"),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.style.primaryColor} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {openGraphImage && <meta property="og:image" content={openGraphImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    {schemaBlocks.map((schema) => <script is:inline type="application/ld+json" set:html={schema} />)}
    <title>{title}</title>
  </head>
  <body style={`--brand:${site.style.primaryColor};--on-brand:${site.style.contrastColor || "#ffffff"};--brand-ink:${site.style.brandTextColor || site.style.primaryColor};--brand-surface:${site.style.brandSurfaceColor || site.style.primaryColor};--on-brand-surface:${site.style.brandSurfaceTextColor || site.style.contrastColor || "#ffffff"};--cream:${site.style.surfaceColor || "#f8f6f0"};--hero-surface:${site.style.heroColor || "#e8eee5"};--ink:${site.style.inkColor || "#14201d"};--muted:${site.style.mutedColor || "#5e6b66"};--line:${site.style.lineColor || "#d8ded7"}`}>
    {!diagnosticPreview && <ReviewBanner />}
    <slot />
    {!diagnosticPreview && <QuickAnswers />}
    {!diagnosticPreview && <ExitOffer />}
  </body>
</html>
