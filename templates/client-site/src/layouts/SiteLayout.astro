---
import site from "../lib/site";
import ReviewBanner from "../components/ReviewBanner.astro";
import "../styles/site.css";

const { title = site.business.name, description = site.business.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.style.primaryColor} />
    <title>{title}</title>
  </head>
  <body style={`--brand:${site.style.primaryColor};--cream:${site.style.surfaceColor || "#f8f6f0"};--hero-surface:${site.style.heroColor || "#e8eee5"};--ink:${site.style.inkColor || "#14201d"};--muted:${site.style.mutedColor || "#5e6b66"};--line:${site.style.lineColor || "#d8ded7"}`}>
    <ReviewBanner />
    <slot />
  </body>
</html>
