---
import { resolvePalette, semanticColorCss } from "../lib/color-policy.mjs";
import { fontFaceCss, resolveFontPairing } from "../lib/font-catalog.mjs";
import site, { routeInventory, routePageBrief } from "../lib/site";
import ReviewBanner from "../components/ReviewBanner.astro";
import { hasPipelineTest } from "../lib/seo-readiness.mjs";
import QuickAnswers from "../components/QuickAnswers.astro";
import ExitOffer from "../components/ExitOffer.astro";
import "../styles/site.css";

const { title = site.business.name, description = site.business.description, schemas = [] } = Astro.props;
const palette = resolvePalette(site.style);
const pairing = resolveFontPairing(site.style);
const bodyVars = [
  `--brand:${palette.primaryColor}`,
  `--on-brand:${palette.contrastColor || "#ffffff"}`,
  `--brand-ink:${palette.brandTextColor || palette.primaryColor}`,
  `--brand-surface:${palette.brandSurfaceColor || palette.primaryColor}`,
  `--on-brand-surface:${palette.brandSurfaceTextColor || palette.contrastColor || "#ffffff"}`,
  `--cream:${palette.surfaceColor || "#f8f6f0"}`,
  `--hero-surface:${palette.heroColor || "#e8eee5"}`,
  `--ink:${palette.inkColor || "#14201d"}`,
  `--muted:${palette.mutedColor || "#5e6b66"}`,
  `--line:${palette.lineColor || "#d8ded7"}`,
  ...(pairing.headingStack ? [`--font-heading:${pairing.headingStack}`] : []),
  ...(pairing.bodyStack ? [`--font-body:${pairing.bodyStack}`] : []),
  ...(palette.accentColor
    ? [
        `--accent:${palette.accentColor}`,
        `--accent-ink:${palette.accentTextColor || palette.accentColor}`,
        `--on-accent:${palette.accentContrastColor || "#ffffff"}`,
        `--ll-accent:${palette.accentMarkColor}`,
        `--ll-accent-text:${palette.accentTextColor}`,
        `--ll-accent-text-on-hero:${palette.accentTextHero}`,
        `--ll-accent-text-on-brand:${palette.accentTextBrand}`,
        `--ll-accent-text-on-dark:${palette.accentTextDark}`,
        `--ll-accent-text-on-light-band:${palette.accentTextLightBand}`,
      ]
    : []),
].join(";");
const colorRoles = semanticColorCss(palette) + `
.recipe-care-editorial {--care-hero-muted:${palette.surfaces.hero.mutedText};}
.service-card:hover p { color: ${palette.surfaces.cardHover.mutedText}; }
.lead-form :is(input,textarea,select) {border-color:var(--ll-border,${palette.surfaces.light.border});}
.split-section :is(a,button):focus-visible {outline:2px solid ${palette.surfaces.brand.focus};outline-offset:3px;}
`;
const testPreview = hasPipelineTest(site);
const testProfile = site.pipelineTest?.profile;
const skippedLane = testProfile === "seo-only" ? "Creative evaluation and visual promotion" : testProfile === "creative-only" ? "SEO research" : "Unknown pipeline lane";
const diagnosticPreview = testPreview || import.meta.env.PUBLIC_CREATIVE_DIAGNOSTIC === "true";
// Judge previews render the authored candidate only. Platform chrome such as
// the floating website-assistant launcher and the exit offer must not appear
// in the captures that authors and judges score.
const judgePreview = import.meta.env.PUBLIC_CREATIVE_JUDGE === "true";
const route = routeInventory.records.find(record => record.path === Astro.url.pathname);
const noIndex = import.meta.env.PUBLIC_REVIEW_MODE === "true" || diagnosticPreview || route?.discovery.indexable === false;
// The approved deployment origin is supplied at build time. A domain in the
// intake is not necessarily connected to Pages and must not become canonical.
const canonical = import.meta.env.PUBLIC_REVIEW_MODE === "true" || diagnosticPreview ? undefined : new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const brief = route ? routePageBrief(route.id) : null;
const pageImage = brief?.mode === "supported" ? brief.media[0]?.src : site.images.hero;
const openGraphImage = pageImage ? new URL(pageImage, Astro.site ?? Astro.url).href : undefined;
const businessIdentity = new URL("/#business", Astro.site ?? Astro.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": site.industry === "home-services" ? "HomeAndConstructionBusiness" : "LocalBusiness",
  "@id": businessIdentity,
  name: site.business.name,
  description,
  telephone: site.business.phone || undefined,
  email: site.business.email || undefined,
  address: site.business.address || undefined,
  areaServed: site.business.serviceAreas.length ? site.business.serviceAreas : undefined,
  url: canonical,
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
const schemaBlocks = (Array.isArray(schemas) ? schemas : []).map((schema) =>
  JSON.stringify(schema).replace(/</g, "\\u003c"),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.style.primaryColor} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    {openGraphImage && <meta property="og:image" content={openGraphImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    {schemaBlocks.map((schema) => <script is:inline type="application/ld+json" set:html={schema} />)}
    <style is:inline set:html={colorRoles} />
    <style is:inline set:html={fontFaceCss()} />
    <title>{title}</title>
  </head>
  <body data-ll-route={Astro.url.pathname} style={bodyVars}>
    {site.demoNotice && !judgePreview && (
      <aside class="ll-demo-notice" data-demo-notice role="note" aria-label={site.demoNotice}>
        <strong>{site.demoNotice}</strong>
        <span>This is not a real business or service offering.</span>
      </aside>
    )}
    {testPreview ? (
      <aside class="ll-demo-notice" data-pipeline-test-preview role="note" aria-label="Test-only pipeline preview">
        <strong>Test-only preview: {testProfile || "invalid profile"}</strong>
        <span>{skippedLane} skipped. Approval, client release and form submissions are disabled.</span>
      </aside>
    ) : <ReviewBanner diagnosticPreview={diagnosticPreview} />}
    <slot />
    {!diagnosticPreview && !judgePreview && <QuickAnswers />}
    {!diagnosticPreview && !judgePreview && <ExitOffer />}
  </body>
</html>

<style>
  .ll-demo-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.5rem;
    padding: 0.4rem 1rem;
    background: #14201d;
    color: #fff;
    font: 600 0.75rem/1.35 system-ui, sans-serif;
    text-align: center;
  }

  .ll-demo-notice strong {
    font-weight: 800;
  }
</style>
