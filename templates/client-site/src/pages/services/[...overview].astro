---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ServicesIndexCandidateHost from "../../components/ServicesIndexCandidateHost";
import site, { phoneHref, routeIsRendered, serviceHref, approvedServices } from "../../lib/site";
import { compileExperiencePack } from "../../lib/experience-pack";
import { resolvePageRecipe } from "../../lib/page-recipe";
import "../../styles/creative-runtime.css";
import "../../generated-experiences/selected/styles.css";

export function getStaticPaths() { return routeIsRendered("/services/") ? [{ params: { overview: undefined } }] : []; }

const { recipe } = resolvePageRecipe(site);
const creativeServicesIndex = Boolean(
  site.design?.experience?.renderer === "creative-candidate" &&
    site.design?.experience?.candidateId &&
    site.design?.experience?.servicesIndex === true,
);
const experience = site.design?.experience?.packId || creativeServicesIndex
  ? compileExperiencePack(site, recipe)
  : null;
const diagnostic = import.meta.env.PUBLIC_CREATIVE_DIAGNOSTIC === "true";
const creativeRuntime = {
  candidateId: site.design?.experience?.candidateId || "selected",
  diagnostic,
  lead: {
    apiUrl: diagnostic ? "" : site.lead?.apiUrl || "",
    token: diagnostic ? "" : site.lead?.token || "",
  },
  reviews: {
    apiUrl: site.socialProof?.google?.apiUrl || "",
    token: site.socialProof?.google?.token || "",
  },
};
---

<SiteLayout title={`Services | ${site.business.name}`} description={`Explore confirmed services from ${site.business.name}. Contact the team to discuss the right next step.`}>
  {creativeServicesIndex && experience ? (
    <div
      data-authored-page-host="true"
      data-authored-page-kind="services-index"
      data-creative-renderer="creative-candidate"
      data-creative-candidate={creativeRuntime.candidateId}
      data-creative-family={site.design?.experience?.familyId || "unknown"}
    >
      <ServicesIndexCandidateHost client:load content={experience.content} runtime={creativeRuntime} />
    </div>
  ) : (
    <>
      <Header />
      <main class:list={["inner-page", `recipe-${site.design?.recipe || "general-editorial"}`]}>
        <section class="inner-hero">
          <div class="wrap inner-hero-grid">
            <div>
              <a class="breadcrumb" href="/">Home</a>
              <span class="kicker">Services</span>
              <h1>{site.copy?.servicesHeading || `Services from ${site.business.name}`}</h1>
              <p>{site.copy?.servicesIntro || `Review the services ${site.business.name} confirmed and contact the team about your needs.`}</p>
              <div class="hero-actions">
                <a class="cta" href="#services-list">Explore services</a>
                {site.business.phone && <a class="call-link" href={phoneHref(site.business.phone)}>Call {site.business.phone}</a>}
              </div>
            </div>
            {site.images.hero && <img src={site.images.hero} alt={`${site.business.name} service context`} fetchpriority="high" />}
          </div>
        </section>
        <section class="section wrap" id="services-list">
          <div class="section-heading"><span class="kicker">Confirmed services</span><h2>Choose the service that fits your need.</h2></div>
          <div class="service-grid">
            {approvedServices.map((service) => (
              <a class="service-card" href={serviceHref(service.slug)}>
                <h3>{service.name}</h3><p>{service.description}</p><b>View service details <i aria-hidden="true">↗</i></b>
              </a>
            ))}
          </div>
        </section>
      </main>
      <Footer />
    </>
  )}
</SiteLayout>
