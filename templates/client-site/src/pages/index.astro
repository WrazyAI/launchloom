---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import LeadForm from "../components/LeadForm.astro";
import Footer from "../components/Footer.astro";
import site, { phoneHref } from "../lib/site";

const wellness = site.preset === "wellness";
const copy = site.copy || {};
const galleryImages = [site.assets?.photoThree, site.assets?.teamPhoto].filter((image): image is string => Boolean(image));
---

<SiteLayout>
  <Header />
  <main>
    <section class:list={["hero", { wellness }]}>
      <div class="wrap hero-grid"><div class="hero-copy"><span class="kicker">{copy.heroKicker || (wellness ? "Personal care, planned with you" : "A clear next step starts here")}</span><h1>{site.business.tagline}</h1><p>{site.business.description}</p>{site.business.offer && <div class="offer">{site.business.offer}</div>}<div class="hero-actions"><a class="cta" href="#contact">{site.business.primaryCta}</a><a class="call-link" href={phoneHref(site.business.phone)}>Call {site.business.phone}</a></div></div>{site.images.hero ? <img class="hero-image" src={site.images.hero} alt={`${site.business.name} service`} /> : <div class="hero-art" aria-label={site.business.name}><span>{site.assets?.logo ? <img src={site.assets.logo} alt={site.business.name} /> : site.business.name}</span></div>}</div>
    </section>
    <section class="proof wrap"><p>{site.differentiators.join(" · ")}</p></section>
    <section class="section wrap" id="services"><span class="kicker">What we do</span><h2>{copy.servicesHeading || (wellness ? "Care tailored to your goals." : "The help you need, without the runaround.")}</h2><div class="service-grid">{site.services.map((service, index) => <a class="service-card" href={wellness ? "#contact" : `/services/${service.slug}/`}><span>0{index + 1}</span><h3>{service.name}</h3><p>{service.description}</p><b>Learn more →</b></a>)}</div></section>
    <section class="split-section" id="about"><div class="wrap split-grid">{site.images.secondary ? <img src={site.images.secondary} alt={`${site.business.name} team or service`} loading="lazy" /> : <div class="split-art" aria-hidden="true" />}<div><span class="kicker">{copy.aboutKicker || "Why clients choose us"}</span><h2>{copy.aboutHeading || (wellness ? "Real expertise. A more personal standard." : "A more straightforward way to get help.")}</h2><p>{site.differentiators.join(". ")}.</p><ul>{site.differentiators.map((item) => <li>{item}</li>)}</ul></div></div></section>
    {galleryImages.length > 0 && <section class="section wrap image-gallery" aria-label={`${site.business.name} photos`}>{galleryImages.map((image, index) => <img src={image} alt={`${site.business.name} ${index === 0 ? "at work" : "team"}`} loading="lazy" />)}</section>}
    {site.preset === "home-services" && <section class="section wrap" id="areas"><span class="kicker">Where we work</span><h2>Local help across your area.</h2><div class="area-list">{site.locations.length ? site.locations.map((location) => <a href={`/locations/${location.slug}/`}>{location.name} →</a>) : site.business.serviceAreas.map((area) => <span>{area}</span>)}</div></section>}
    <section class="contact-section" id="contact"><div class="wrap contact-grid"><div><span class="kicker">{copy.contactKicker || "Ready when you are"}</span><h2>{copy.contactHeading || site.business.primaryCta}.</h2><p>{site.business.offer || "Tell us what you need and we’ll get back to you promptly."}</p><p class="contact-detail">{site.business.address}<br />{site.business.hours}</p></div><LeadForm /></div></section>
  </main>
  <a class="mobile-call" href={phoneHref(site.business.phone)}>Call now</a>
  <Footer />
</SiteLayout>
