---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import PageSections from "../components/PageSections.astro";
import Footer from "../components/Footer.astro";
import site from "../lib/site";
import { resolvePageRecipe } from "../lib/page-recipe";

const page = resolvePageRecipe(site);
const density = site.design?.treatment?.density || "balanced";
const typography = site.design?.treatment?.typography || (page.recipe === "local-trades" ? "strong" : "editorial");
---

<SiteLayout>
  <Header />
  <main class:list={["site-main", `recipe-${page.recipe}`, `layout-${site.conversion?.layout || "editorial-authority"}`, `density-${density}`, `type-${typography}`]}>
    <PageSections page={page} />
  </main>
  <Footer />
</SiteLayout>
