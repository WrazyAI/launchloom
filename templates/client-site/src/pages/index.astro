---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import PageSections from "../components/PageSections.astro";
import Footer from "../components/Footer.astro";
import site from "../lib/site";
import { resolvePageRecipe } from "../lib/page-recipe";

const page = resolvePageRecipe(site);
---

<SiteLayout>
  <Header />
  <main class:list={["site-main", `recipe-${page.recipe}`, `layout-${site.conversion?.layout || "editorial-authority"}`]}>
    <PageSections page={page} />
  </main>
  <Footer />
</SiteLayout>
