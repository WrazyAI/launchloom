---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Header from "../../components/Header.astro";
import LeadForm from "../../components/LeadForm.astro";
import Footer from "../../components/Footer.astro";
import PageBriefSections from "../../components/PageBriefSections";
import LocationCandidateHost from "../../components/LocationCandidateHost";
import site, { serviceHref, phoneHref, approvedServices, routePageBrief, type Location } from "../../lib/site";
import { compileExperiencePack } from "../../lib/experience-pack";
import { hasPipelineTest } from "../../lib/seo-readiness.mjs";
import { resolvePageRecipe } from "../../lib/page-recipe";
import "../../styles/experience-packs.css";
import "../../styles/creative-runtime.css";
import "../../generated-experiences/selected/styles.css";

export function getStaticPaths() {
  return site.locations.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}
const { location } = Astro.props as { location: Location };
const brief = routePageBrief(`location:${location.name.trim().toLowerCase()}`);
const supported = brief?.mode === "supported";
const admission = site.routePolicy?.decisions.find(decision => decision.pageType === "location" && (decision.target || "").trim().toLowerCase().replace(/\s+/gu," ") === location.name.trim().toLowerCase().replace(/\s+/gu," "))?.admission;
const localServices = supported ? approvedServices.filter(service => admission?.services.some(name=>name.trim().toLowerCase().replace(/\s+/gu," ")===service.name.trim().toLowerCase().replace(/\s+/gu," "))) : approvedServices;
const otherAreas = site.locations.filter((area) => area.slug !== location.slug).slice(0, 6);
const garage = site.businessKind === "garage-door";
const locationImage = brief?.media[0]?.src || (supported ? "" : site.images.hero);
const serviceLabel = garage ? "Garage door help" : `${site.services[0]?.name || "Local service"}`;
const { recipe, treatment } = resolvePageRecipe(site);
const creativeLocationPage = Boolean(
  site.design?.experience?.renderer === "creative-candidate" &&
    site.design?.experience?.candidateId &&
    site.design?.experience?.locationPage === true,
);
const experience = site.design?.experience?.packId || creativeLocationPage
  ? compileExperiencePack(site, recipe)
  : null;
const diagnostic = hasPipelineTest(site) || import.meta.env.PUBLIC_CREATIVE_DIAGNOSTIC === "true";
const creativeRuntime = {
  candidateId: site.design?.experience?.candidateId || "selected",
  diagnostic,
  lead: {
    apiUrl: diagnostic ? "" : site.lead?.apiUrl || "",
    token: diagnostic ? "" : site.lead?.token || "",
  },
  reviews: {
    apiUrl: site.socialProof?.google?.apiUrl || "",
    token: site.socialProof?.google?.token || "",
  },
};
const creativeLocation = creativeLocationPage
  ? {
      name: location.name,
      slug: location.slug,
      brief: supported ? brief : null,
      description:
        (supported ? brief.introduction : location.description) ||
        `${site.business.name} serves customers in ${location.name}. Contact the team to confirm availability for your address.`,
      localNote:
        (supported ? `Confirm your ${location.name} address and requested service before making arrangements.` : location.localNote) ||
        "Availability varies by address and service need. Contact the team to confirm coverage before scheduling.",
      services: localServices.map(({ name, slug, description }) => ({ name, slug, description })),
      otherAreas: otherAreas.map(({ name, slug }) => ({ name, slug })),
      images: { context: brief?.media[0]?.src || (supported ? "" : site.images.hero || site.images.secondary || ""), alt: brief?.media[0]?.alt || location.name },
    }
  : null;
---

<SiteLayout title={supported ? brief.metadata.title : `${site.services[0]?.name || "Local service"} in ${location.name} | ${site.business.name}`} description={(supported ? brief.metadata.description : location.description) || `${site.business.name} serves customers in ${location.name}. Contact the team to confirm availability for your address.`}>
  {creativeLocation && experience ? (
    <div
      data-authored-page-host="true"
      data-authored-page-kind="location"
      data-creative-renderer="creative-candidate"
      data-creative-candidate={creativeRuntime.candidateId}
      data-creative-family={site.design?.experience?.familyId || "unknown"}
    >
      <LocationCandidateHost client:load content={experience.content} runtime={creativeRuntime} location={creativeLocation} />
    </div>
  ) : (
    <>
      <Header />
      <main class:list={["inner-page", `recipe-${recipe}`, `type-${treatment.typography}`, experience && `inner-experience-${experience.program.packId}`]} data-experience-pack={experience?.program.packId}>
        <section class="inner-hero location-hero"><div class="wrap inner-hero-grid"><div><a class="breadcrumb" href="/">Home / Service areas</a><span class="kicker">Serving {location.name}</span><h1>{serviceLabel} in {location.name}.</h1><p>{(supported ? brief.introduction : location.description) || `${site.business.name} serves ${location.name}. Tell us what service you need and we will confirm coverage and the next available step for your address.`}</p><div class="hero-actions"><a class="cta" href="#contact">{site.business.primaryCta}</a>{site.business.phone && <a class="call-link" href={phoneHref(site.business.phone)}>Call {site.business.phone}</a>}</div></div>{locationImage && <img src={locationImage} alt={brief?.media[0]?.alt || `${serviceLabel} context for ${location.name}`} />}</div></section>

        <section class="section wrap location-services"><div class="section-heading"><span class="kicker">Services available by request</span><h2>{recipe === "care-editorial" ? "Explore the support you are considering." : "Start with the issue you are seeing."}</h2>{!supported && <p>{location.localNote || "Availability varies by address and service need. Contact the team to confirm coverage before scheduling."}</p>}</div><div class="service-grid">{localServices.map((service) => <a class="service-card" href={serviceHref(service.slug)}><h3>{service.name}</h3><p>{service.description}</p><b>View service details <i aria-hidden="true">↗</i></b></a>)}</div></section>

        {supported ? <PageBriefSections brief={brief} /> : <>
        <section class="inner-band locality-band"><div class="wrap coverage-grid"><div><span class="kicker">Local coverage</span><h2>One clear way to check your address.</h2><p>Send the property address and a short description of the problem. The team will confirm whether the requested service is available in {location.name}.</p></div>{otherAreas.length > 0 && <div><strong>Other listed service areas</strong><div class="area-list">{otherAreas.map((area) => <a href={`/locations/${area.slug}/`}>{area.name}<span aria-hidden="true">↗</span></a>)}</div></div>}</div></section>

        <section class="section wrap service-decision"><div class="section-heading"><span class="kicker">Before scheduling</span><h2>Details that help the team prepare.</h2></div><div class="decision-grid"><div><h3>{garage ? "Describe the symptom" : "Describe the service need"}</h3><p>{garage ? "Share what you hear, see, or cannot operate. Avoid handling springs, cables, or a door that appears unstable." : "Share what you need help with and any details that affect the requested service."}</p></div><div><h3>Share the address</h3><p>The exact address lets the team confirm that your property is within the current service area.</p></div><div><h3>Choose your timing</h3><p>Tell the team when you would like help. They will respond with current availability rather than an unverified promise.</p></div></div></section>

        </>}

        <section data-ll-surface="contact" class="contact-section" id="contact"><div class="wrap contact-grid"><div class="contact-copy"><span class="kicker">Service in {location.name}</span><h2>{site.business.primaryCta}</h2><p>Share your address and service need so the team can confirm coverage.</p>{site.business.phone && <a class="contact-phone" href={phoneHref(site.business.phone)}>{site.business.phone}</a>}</div><LeadForm id={`location-${location.slug}`} /></div></section>
      </main>
      <Footer />
    </>
  )}
</SiteLayout>
